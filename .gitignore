# -- your real, personal files -- never tracked, never overwritten ----------
# Only the generic *.example versions are published. Your own filled-in
# copies stay invisible to git, whether you keep them at their ordinary
# paths (below) or together in a *.local directory (bottom rule) -- see
# README.md. Nothing in this project ever deletes or overwrites them.
/settings.toml
/site/*
!/site/*.example

# -- runtime/local state -----------------------------------------------------
/data/
/secrets/
__pycache__/
*.pyc
*.pyo

# -- local build output -------------------------------------------------------
*.egg-info/
build/
dist/
.venv/
venv/

# -- editor/OS cruft -----------------------------------------------------------
.DS_Store
*.swp

# Local-only files: never published, carried between machines by
# the container repo (see its .git.force-add-patterns).
*.local
*.local.*
