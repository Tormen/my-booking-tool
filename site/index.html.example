<!-- MANAGED BY YOU, NOT my-bt -- this is a generic starting-point homepage,
     not generated. Copy to site/index.html (untracked -- see README.md
     "Static-site pages"), replace every REPLACE-ME marker, and update the
     course list below to match your own settings.toml [[course]] entries
     (shortname must match exactly -- that's what /book/<shortname>
     resolves to).

     2026-07-06: the small "Login" link/button below always starts out
     plain, static HTML -- target="_top" is load-bearing, not decoration:
     this page is also embedded via <iframe> elsewhere (a separate "center
     homepage"), and target="_top" is what makes clicking Login break OUT
     of that iframe and navigate the WHOLE browser tab to /my, instead of
     trying (and likely failing, or looking broken) to load the login page
     inside a small embedded iframe. Viewed standalone, it behaves like a
     normal same-tab link -- no downside either way.

     2026-07-16: EVERY link on this page that points at the booking tool
     itself (course links, the footer's Terms/Privacy/Impressum, and the
     schedule-exceptions script's "details" links) carries target="_top"
     for the same reason, not just Login -- the session cookie any of
     these pages might set (login, sign-up-and-book) is SameSite=Lax,
     which a cross-site <iframe> sub-frame request never gets to send/
     receive properly; breaking out to the top frame makes the request an
     ordinary same-site one instead. Keep this on any new internal link
     added here.

     2026-07-09: a logged-in guest visiting the homepage should see the
     same banner as the dynamic pages, not a plain "Login" button. The
     <script> at the bottom of <body> opportunistically upgrades this on
     load: it asks
     GET /my/session (same-origin fetch, so it carries the guest's session
     cookie automatically even though this page's own JS can never read
     that cookie directly) and, only if it comes back logged in, swaps
     this button for a "My bookings" link + "Log out" button. IMPORTANT
     limitation this can't get around: fetching /my/session from INSIDE
     the iframe embed mentioned above is a third-party request relative to
     the embedding page's origin, and modern browsers increasingly block
     or partition third-party cookies by default -- so the swap may simply
     not happen there even when the guest really is logged in (in the
     top-level tab). That's not a bug, it's the same constraint this
     comment used to cite as the reason for having NO session-awareness at
     all; a failed/negative check just leaves the plain Login button in
     place (the exact prior behavior), so this is a pure enhancement for a
     direct/standalone visit, never a regression for the iframe-embedded
     one. If you remove or restyle this, keep the target="_top" attribute
     on BOTH the Login link and the swapped-in form (forms support
     target= too) -- see README.md's "Login banner" section for more, and
     "Course overview page" for the equivalent dynamic banner already used
     on /courses and /book. -->
<html>
<head>
<meta http-equiv=Content-Type content="text/html; charset=utf-8">
<title>REPLACE-ME-YOUR-SITE-NAME</title>
<style>
 body { max-width: 760px; margin: 2em auto; padding: 0 1em; font-family: sans-serif; }
 footer { margin-top: 3em; font-size: 0.85em; color: #666; }
 /* A row that takes NO height: it sits in normal flow right after the
   exceptions banner (so the button is below the red bar, never on it),
   its content overflows downward in front of what follows, and because
   it is a block rather than a float it does not narrow the line boxes
   beside it -- which is what made the centred <h1> drift left when this
   was a float (2026-08-27, spotted from a screenshot). */
.top-bar { height: 0; text-align: right; position: relative; z-index: 1; }
 .login-btn { font-size: 0.85em; padding: 0.3em 0.9em; border: 1px solid #ccc; border-radius: 4px;
              text-decoration: none; color: #222; }
 .login-btn:hover { background: #f4f7f4; }
 .attention { background: #fdecea; border: 1px solid #f5c2c0; border-radius: 8px;
              padding: 0.8em 1.2em; margin: 0.6em 0; color: #a61b1b;
              font-family: sans-serif; font-size: 1rem; }
 /* 2026-07-13: explicit here (not just relying on inheriting it from
    `body` above) so this box's font can never silently drift from the
    dynamic app pages' own ATTENTION box (app/webapp.py::attention_html())
    even if `body`'s own font-family rule above is ever changed -- see
    site/index.html's own (real, Word-exported) copy of this same comment
    for the actual incident this fixes. */
 .attention a { color: #a61b1b; }

 /* The banner's list is the LAST thing in the box, so its default
    bottom margin lands on top of the box's own padding and reads as a
    stray gap under the text. The box's padding alone is the spacing
    here -- same reasoning as .selected-box on the booking page. */
 .attention ul { margin: 0.25em 0 0; padding-left: 1.4em; }
 /* The page-wide `li { margin-bottom: 0.35em }` above also applies to
    the LAST bullet, where it stacks on the box's own padding and makes
    the bottom gap larger than the top one. Zeroed here; the spacing
    BETWEEN bullets is put back on the next line. */
 .attention ul li { margin-bottom: 0; }
 .attention ul li + li { margin-top: 0.2em; }

/* Booking links lead to a page that consults the calendar before it can
   render -- seconds when the conflict feed is cold -- and until it
   arrives the browser keeps showing THIS page, so the click looks
   ignored. Same shape and same 250ms rule as the app's own pages.
   NOTE: index_embedded.html is script-free by design, so it does not get
   this; a CSS-only version would need :focus, which Safari does not give
   a clicked link. */
.loading-overlay { position: fixed; inset: 0; z-index: 1200;
  background: rgba(255,255,255,.8); display: flex; align-items: center;
  justify-content: center; }
.skeleton { background: #fff; border: 1px solid #ddd; border-radius: 8px;
  padding: 1.4em 1.6em; box-shadow: 0 8px 30px rgba(0,0,0,.18);
  width: min(92%, 520px); }
.sk { display: block; border-radius: 6px; background: #ececec; margin: 0 0 .7em;
  background-image: linear-gradient(90deg,#ececec 0%,#f7f7f7 40%,#ececec 80%);
  background-size: 300% 100%; animation: sk-sweep 1.2s linear infinite; }
.sk-title { height: 1.5em; width: 55%; margin-bottom: 1.1em; }
.sk-line { height: .9em; }
.sk-line.short { width: 70%; }
.sk-grid { background: none; animation: none; display: grid;
  grid-template-columns: repeat(3,1fr); gap: .5em; margin: 1em 0; }
.sk-grid i { display: block; height: 3.2em; border-radius: 6px; background: #ececec;
  background-image: linear-gradient(90deg,#ececec 0%,#f7f7f7 40%,#ececec 80%);
  background-size: 300% 100%; animation: sk-sweep 1.2s linear infinite; }
.sk-btn { height: 2.2em; width: 9em; margin-top: 1.2em; }
@keyframes sk-sweep { from { background-position: 150% 0 } to { background-position: -150% 0 } }
@media (prefers-reduced-motion: reduce) { .sk, .sk-grid i { animation: none } }
</style>
</head>
<body>


<!-- 2026-07-16: exceptional per-date schedule changes (settings.toml's
     [[course.date_override]], see app/config.py::CourseDateOverride) --
     filled in by the <script> at the bottom of <body>, same opportunistic
     same-origin-fetch pattern as the Login/Logout swap above. Left empty
     (no banner at all) whenever nothing's coming up. Keep this div -- move
     it if you like, but don't remove the id. -->
<div id="schedule-exceptions"></div>
<div class="top-bar" id="top-bar"><a class="login-btn" href="/my" target="_top">Login</a></div>

<h1>REPLACE-ME-YOUR-SITE-NAME</h1>

<p>REPLACE-ME: a short description of what you offer and who it's for.</p>

<h2>Upcoming sessions</h2>
<ul>
  <li><a href="/book/example-monday-class" target="_top">Example Class -- Monday 18:00: book your place here.</a></li>
  <li><a href="/book/example-thursday-class" target="_top">Example Class (Advanced) -- Thursday 19:00: book your place here.</a></li>
</ul>

<footer>
<a href="/terms.html" target="_top">Terms</a> &nbsp;|&nbsp;
<a href="/privacy.html" target="_top">Privacy policy</a> &nbsp;|&nbsp;
<a href="/impressum.html" target="_top">Impressum / Legal notice</a>
</footer>

<script>
// See the top-of-file comment for the full reasoning/limitations.
// Opportunistic only: any failure here (network, JS disabled, blocked
// third-party cookie inside the <iframe> embed) just leaves the plain
// Login button in place -- exactly what was there before this existed.
(function () {
  fetch('/my/session', { credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (!data.logged_in) return;
      var bar = document.getElementById('top-bar');
      if (!bar) return;
      bar.innerHTML =
        '<a class="login-btn" href="/my" target="_top">My bookings</a>' +
        '<form method="post" action="/my/logout" target="_top" style="display:inline;margin-left:0.4em">' +
        '<button type="submit" class="login-btn" style="border:none;cursor:pointer">Log out</button>' +
        '</form>';
    })
    .catch(function () { /* stay on the plain Login button */ });
})();
</script>

<script>
// Schedule exceptions (2026-07-16): fetches app/webapp.py::schedule_exceptions,
// a public/read-only JSON list of upcoming [[course.date_override]] entries
// across every course, and renders one red ATTENTION line per item. course_title/
// message are operator-authored (settings.toml, same trust boundary as course
// description elsewhere in this app) -- deliberately not escaped here, exactly
// like that content isn't escaped server-side either. Opportunistic only: any
// failure (network, JS disabled) just leaves the page with no banner at all,
// same as before this existed.
(function () {
  fetch('/schedule-exceptions', { credentials: 'same-origin' })
    .then(function (r) { return r.json(); })
    .then(function (items) {
      if (!items || !items.length) return;
      var el = document.getElementById('schedule-exceptions');
      if (!el) return;
      el.innerHTML = items.map(function (it) {
        var msg = it.message ? ' -- ' + it.message : '';
        return '<div class="attention"><b>⚠ ATTENTION:</b> ' + it.course_title +
          ' on ' + it.date + ' starts at ' + it.time_label + ' instead' + msg +
          ' -- <a href="/book/' + it.course_shortname + '" target="_top">details</a></div>';
      }).join('');
    })
    .catch(function () { /* leave the page exactly as-is */ });
})();
</script>

<script>
// A click on any link to this site starts a timer; the panel appears
// only if the page has not been replaced 250ms later, so a fast
// navigation never flashes it. Nothing here runs for an external link,
// a fragment, or a click that opens a new tab.
(function () {
  var timer = null;
  document.addEventListener('click', function (ev) {
    var a = ev.target.closest ? ev.target.closest('a') : null;
    if (!a || ev.defaultPrevented || ev.button !== 0) return;
    if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
    var href = a.getAttribute('href') || '';
    if (!href || href.charAt(0) === '#') return;
    if (/^[a-z]+:/i.test(href) && a.origin !== window.location.origin) return;
    if (timer) return;
    timer = setTimeout(function () {
      var back = document.createElement('div');
      back.className = 'loading-overlay';
      back.innerHTML = "<div class='skeleton' role='status' aria-label='Loading'>" +
        "<span class='sk sk-title'></span>" +
        "<span class='sk sk-line'></span><span class='sk sk-line short'></span>" +
        "<span class='sk sk-grid'><i></i><i></i><i></i><i></i><i></i><i></i></span>" +
        "<span class='sk sk-line'></span><span class='sk sk-btn'></span></div>";
      document.body.appendChild(back);
    }, 250);
  });
  window.addEventListener('pageshow', function () {
    if (timer) { clearTimeout(timer); timer = null; }
    var panel = document.querySelector('.loading-overlay');
    if (panel) panel.remove();
  });
})();
</script>
</body>
</html>
