# REPLACE-ME-YOUR-DOMAIN - main site + proxied booking app.
# HARDENED nginx vhost reference. This is the real, production config
# for booking.example.org, anonymized (see "REPLACE-ME" markers below) --
# a genuinely richer starting point than the bare nginx/my-booking.conf
# (which is just the location blocks, no rate limiting/headers/CSP at
# all). Copy this to site/nginx-locations.conf (untracked -- a FIXED
# filename regardless of your own domain, same convention as every other
# real-vs-.example pair in site/, e.g. site/index.html vs.
# site/index.html.example -- see README.md "Static-site pages"), replace
# every REPLACE-ME marker with your own real values, then wire it into
# your nginx sites-enabled/conf.d the normal way (nginx doesn't care what
# the file is called, only that it's included).
#
# We use a separate server statement for the HTTP->HTTPS redirect and NOT an
# if-statement inside this block - see http://wiki.nginx.org/IfIsEvil
# (The redirect server{} block further down still uses certbot's original
# if-based idiom for host matching; that one's fine as-is, see note there.)

# ---------------------------------------------------------------------------
# Serve the no-JavaScript homepage variant to <iframe> embeds (see
# index_embedded.html in README.md "Static-site pages").
#
# A cross-origin frame carrying inline JavaScript is what security suites,
# corporate web filters and privacy extensions react to -- several report
# it to the visitor as an "XSS" block and refuse to render the frame at
# all. index_embedded.html has no <script> tags whatsoever and every link
# on it opens in a new top-level tab, so the framed document gives them
# nothing to object to.
#
# Every current browser states what a navigation is FOR: Sec-Fetch-Dest is
# "iframe" for a framed load and "document" for an ordinary one (Chrome 76+,
# Firefox 90+, Safari 16.4+). Nothing here depends on WHO is embedding --
# that would need Referer, which the embedding page controls and can
# suppress. Which sites may embed at all stays the CSP frame-ancestors
# directive's job, further down.
#
# This needs no cooperation from the embedding site: it keeps working
# whatever URL they point their <iframe> at, as long as it is this site's
# root. A browser too old to send the header simply gets index.html, i.e.
# exactly what it got before. The try_files fallback below means a
# deployment that has not deployed index_embedded.html serves index.html to
# everyone, so this is safe to leave in place unconditionally.
map $http_sec_fetch_dest $index_variant {
    default  /index.html;
    iframe   /index_embedded.html;
}

# Request timing in the access log (2026-08-27). nginx's `combined`
# format records no duration at all, so "the page felt slow" could only
# ever be measured from a browser -- which mixes in extension overhead
# and rendering. rt is the time nginx spent on the whole request; urt is
# what the booking app itself took, so the two separate "our code is
# slow" from "the network is slow".
#
# The two fields are APPENDED, never inserted: app/watchdog.py's parser
# anchors on the combined prefix ($remote_addr ... "$request" $status)
# and ignores whatever follows, so adding to the end cannot break it.
# RATE-LIMIT ZONES THIS FILE REFERENCES -- they are defined in
# nginx.conf (the operator's own hardening config, not shipped by this
# package), and `nginx -t` will refuse to load this file if any is
# missing:
#
#     limit_req_zone $binary_remote_addr zone=booking:10m  rate=30r/m;
#     limit_req_zone $binary_remote_addr zone=homepage:10m rate=60r/m;
#     limit_req_zone $binary_remote_addr zone=admin:10m    rate=120r/m;
#     limit_req_status 429;
#
# booking was 10r/m until 2026-08-27, when ordinary console work tripped
# it: /admin's tabs and "show more dates" are links now, so a minute of
# it is ~8 requests. A guest booking is ~3. limit_req_status 429 says
# "too many requests" instead of nginx's default 503, which is both
# accurate and distinguishable from a real outage in the logs.

log_format timed '$remote_addr - $remote_user [$time_local] "$request" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
                 'rt=$request_time urt=$upstream_response_time';

server {
    server_name REPLACE-ME-YOUR-DOMAIN;
    root /var/www/REPLACE-ME-YOUR-DOMAIN/public_html;

    access_log /var/log/nginx/REPLACE-ME-YOUR-DOMAIN.access.log timed;
    error_log  /var/log/nginx/REPLACE-ME-YOUR-DOMAIN.error.log;

    # HARDENING: cap request bodies at the same 64 KiB the app itself now
    # enforces (app/webapp.py::MAX_REQUEST_BODY_BYTES, 2026-07-14 -- keep
    # the two in sync). No form in this app comes anywhere near this; the
    # nginx default (1m) was needlessly generous for a booking site with
    # no uploads at all.
    client_max_body_size 64k;

    # REPLACE-ME: optional extra include(s) for your own distro/setup's
    # generic hardening snippets, if you have any (e.g. Fedora's stock
    # restrictions.conf). Not required by this app -- purely whatever
    # else you already run on this box.

    # HARDENING: however you manage your TLS cert (certbot, acme.sh, or
    # your hosting provider's own automation) -- REPLACE-ME with your own
    # cert paths.
    listen 443 ssl;
    http2 on;
    ssl_certificate REPLACE-ME-/path/to/fullchain.pem;
    ssl_certificate_key REPLACE-ME-/path/to/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HARDENING: OCSP stapling deliberately NOT enabled here -- Let's
    # Encrypt fully retired their OCSP responder in August 2025, so certs
    # issued since then carry no OCSP AIA URL at all; ssl_stapling would
    # just log "no OCSP responder URL in the certificate" and do nothing.
    # REPLACE-ME: if your CA still serves OCSP, add it back.

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # X-Frame-Options deliberately NOT set here -- it can only ever say
    # "same-origin only" or "deny", with no way to allow one specific OTHER
    # site to frame this one (ALLOW-FROM is deprecated/unsupported in every
    # current browser). If you never embed this site via <iframe>
    # elsewhere, the CSP frame-ancestors 'self' below already gives you the
    # exact same same-origin-only protection. If you DO embed it elsewhere
    # (see index_embedded.html in README.md "Static-site pages"), add that
    # site's origin to frame-ancestors below instead -- REPLACE-ME.

    # HARDENING: Content-Security-Policy, ENFORCED (not report-only).
    # Built from an actual audit of every page this app serves (index,
    # /courses, /book/*, /my, /terms, /privacy, /impressum, /admin/login):
    #   - Zero external resources anywhere (no CDNs, no Google Fonts, no
    #     external scripts/images/frames) - everything is same-origin, so
    #     default-src 'self' is safe as the baseline for everything not
    #     called out below.
    #   - TEN distinct inline <script> blocks exist site-wide as of this
    #     app version (TWENTY-TWO hashes are allow-listed below: one per
    #     current script plus superseded versions' hashes, deliberately
    #     kept per the "ADD, never replace" rule -- rollback safety;
    #     counts corrected 2026-07-14, the notes below used to conflate
    #     scripts with hashes): index.html's login-button script (same-origin
    #     fetch() to /my/session only), the booking-form validation script
    #     shared by all /book/<slug> pages, the sortable/filterable-table
    #     script shared by /my and /admin's own tables, the confirm-dialog
    #     wiring script shared by /my (Cancel/Reinstate buttons) and /admin
    #     (Cancel/Reinstate buttons), the submit-feedback script appended
    #     to EVERY page by app/templates.py::page() (2026-07-11 -- disables
    #     every button and shows "Please wait..." the instant any form is
    #     submitted, so a slow POST doesn't look like nothing happened and
    #     can't be double-submitted from the UI), three more
    #     (2026-07-07, fixing a real CSP violation on /my's
    #     lockout screen): the password-reset page's resend-cooldown
    #     script, the "Almost there" page's fetch-based resend-cooldown
    #     script, and the login/signup/reset/admin-login lockout-countdown
    #     script -- all three used to be built per-call-site with the
    #     button id/label/seconds interpolated directly into the script
    #     text, so every render hashed differently and never matched any
    #     fixed allow-list; they're now stable, data-*-attribute-driven
    #     scripts like the others, one hash apiece -- one more
    #     (2026-07-13): /admin's "cancel entire session" checkbox wiring
    #     script (auto-checks every sibling row sharing an occurrence,
    #     greys out their Cancel buttons -- see
    #     app/webapp.py::_CANCEL_ENTIRE_SESSION_SCRIPT) -- and one more
    #     (2026-07-16, alongside [[course.date_override]]): index.html's
    #     second script, which fetches /schedule-exceptions and splices in
    #     the ATTENTION banner for any upcoming date override -- and one
    #     more (2026-07-13): the booking-form validation script above used
    #     to interpolate [site].max_guests directly into `var MAX_GUESTS =
    #     {max_guests};`, so its hash changed with that one setting and
    #     could never be reliably allow-listed (same class of bug as the
    #     three lockout-countdown scripts above) -- fixed the same way,
    #     via a `data-max-guests` attribute on the form read with
    #     `parseInt(form.dataset.maxGuests, 10)` instead, so the script's
    #     body (and hash) is now the same regardless of max_guests -- and
    #     one more (2026-07-13, same day): the schedule-exceptions script
    #     above was rewritten a SECOND time (combined every exception into
    #     one box, bulleted, weekday-first, plus a new
    #     custom_attention_message), and its hash again went stale the
    #     moment it shipped -- confirmed live via
    #     `my-bt admin csp-violations` (blocked-uri='inline',
    #     violated-directive='script-src-elem') -- and one more
    #     (2026-07-13, same day again): the FIRST run of the new
    #     app.cli_checks.expected_csp_hashes()/check_csp_hashes_deployed()
    #     automation (built specifically to catch this class of bug going
    #     forward -- see below) immediately found that the sortable/
    #     filterable-table script's own hash had ALSO been stale since
    #     2026-07-08 or earlier -- confirmed via a real rendered /admin
    #     page's own script hash not matching anything allow-listed here.
    #     Nobody had noticed because sort/filter is a nice-to-have, not a
    #     blocking control, so it silently did nothing on /my and /admin
    #     for an unknown stretch of time. Every current script is
    #     allow-listed by exact SHA-256 hash below instead of
    #     'unsafe-inline', so any future/injected inline script that
    #     isn't byte-identical to an allow-listed one is blocked
    #     outright. These hashes match the app
    #     as shipped in this repo right now -- if you ever hand-edit any of
    #     app's inline scripts, regenerate the hashes (or run
    #     `my-bt admin health`/`admin setup`, which now checks this
    #     automatically) or those pages' scripts will silently stop working
    #     (this bit a real deployment FOUR times now -- both /my's and
    #     /admin's confirm-dialogs went dead once, the schedule-exceptions
    #     banner never rendered on two separate occasions, and the sortable/
    #     filterable-table script went dead for an unknown stretch of time,
    #     each time with no visible error except a browser-console CSP
    #     violation -- see the CSP-hash automation work in
    #     app/cli_checks.py/app/site_render.py meant to catch this class of
    #     bug automatically going forward).
    #   - 2026-07-13 (same day, yet again): the booking-form script's hash
    #     changed once more -- the Login/Sign-up tabs embedded directly on
    #     /book/<slug> (see app/webapp.py::_login_signup_tabs_html()) meant
    #     the Name/Email fields, the guest rows, and the ack checkbox all
    #     moved outside #book-form's own <form>...</form> tags (associated
    #     back to it via each field's own form="book-form" attribute
    #     instead, since a <form> can't nest inside another <form> and the
    #     Login tab needs its own) -- so the script's lookups switched from
    #     form.querySelector(...) to document.getElementById(...) for
    #     those fields. New hash ADDED via app.cli_checks.
    #     expected_csp_hashes() at the time -- old one kept per this
    #     comment's own "ADD, never replace" rule (rollback safety), which
    #     is why the allow-list below carries more hashes than there are
    #     distinct scripts currently in use -- a superseded version's
    #     hash stays alongside its replacement.
    #   - 2026-07-16: the schedule-exceptions script's "details" link got
    #     target="_top" added (iframe/SameSite break-out fix -- see
    #     app/webapp.py::_login_form_html()'s own docstring for the fuller
    #     reasoning) -- body changed, so its hash did too. New hash ADDED
    #     via app.cli_checks.expected_csp_hashes() at the time (old one
    #     kept, same rollback-safety rule). This one was only caught by
    #     `my-bt admin health` on the LIVE server, after shipping -- the
    #     existing build-time test (test_example_file_has_every_static_
    #     script_hash_current) deliberately skips index.html's own scripts,
    #     since site/index.html.example is a generic placeholder, not real
    #     content. Added TrackedNginxExampleFileTest::
    #     test_real_index_html_script_hashes_are_all_in_the_example_conf
    #     the same day (skips if the real, gitignored site/index.html isn't
    #     present in the checkout) so this specific gap -- a real script
    #     body changing without its hash landing here -- fails at
    #     `python3 -m unittest` time going forward, same as
    #     check_csp_hashes_deployed() already does for the live server. Now
    #     TWENTY-TWO hashes total for the TEN distinct scripts currently in
    #     use -- the extra eight are superseded versions' hashes, kept per
    #     the "ADD, never replace" rule.
    #   - 2026-07-08: the sortable/filterable-table script's hash changed
    #     again (still the same one shared by /my and /admin) -- added the
    #     data-default-sort="asc"|"desc" on-load behavior (default sort is
    #     now by Date, so the sort arrow is visible on load). Body
    #     changed, so the hash did too -- regenerated at the time, but (see
    #     the 2026-07-13 note above) NOT actually kept in sync with later
    #     edits until the automation caught it.
    #   - style-src needs 'unsafe-inline': index.html's script injects new
    #     elements with inline style="..." at runtime (innerHTML), which a
    #     hash/nonce can't cover since the content doesn't exist until the
    #     page runs.
    #   - img-src allows data: for any inline/base64 images; nothing else
    #     external is used.
    #   - object-src/base-uri/form-action locked to 'none'/'self' as standard
    #     defense-in-depth; nothing in this app needs plugins, a <base> tag,
    #     or cross-origin form submission.
    #   - frame-ancestors 'self' blocks EVERY other site from embedding this
    #     one via <iframe> -- real clickjacking protection for /my, /admin,
    #     /book/<slug>'s own state-changing actions, so don't just drop this
    #     to make an embed "work": if you deliberately embed this site
    #     elsewhere (see index_embedded.html in README.md "Static-site
    #     pages"), REPLACE-ME by adding that ONE trusted origin here
    #     instead, e.g. `frame-ancestors 'self' https://example.org;` --
    #     keep it a narrow allow-list, not wide open.
    #   - report-uri: the browser POSTs a JSON violation report to
    #     /csp-report (app/webapp.py::csp_report, logged at WARNING) any
    #     time ANY directive above is violated -- lets you see an attempted
    #     embed from anywhere OTHER than what frame-ancestors allows,
    #     instead of it silently vanishing into the visitor's own browser
    #     console.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Ver5FwEPiXIWU5oQdhCchVlL36wbDj3koRs3pyoKuFY=' 'sha256-ji+DXtYyF5mfZxKrAIka836Kh7UjtO1Qf3WcYFVC+y4=' 'sha256-at+MMlKeVdXjzVWo/1L1cwH1kZ76tB0ZldsC9Hzd9hk=' 'sha256-cmqV8a8IsyPUB5rofb3Xu3LQ/HFchfg3MyNHs+pm0jo=' 'sha256-maFcniVV9LQ4vbnJhxzERo8fk/0Yal3TDXbJaR0XVTc=' 'sha256-Dv7NslhyJvrqABRORabRArZdFuyeyPl2Zuf2IeEWS18=' 'sha256-8ZmcZEZxal12VmeDKw+D9fuCBQzmABcEwfAijR3m93c=' 'sha256-9J6kOUczjow1MfwHxFwHi8OVwjNXnYtfoReeFUO5Mvw=' 'sha256-gSX3W6JYZGwF4pdC9t4ZGGMUJqgSoL96xZI1mzRZb0Q=' 'sha256-/muiZroop/5PvlS9Zmnmo9mtOp8vTmBd3bkkD8CHL4s=' 'sha256-Pnh4gP33m9xwjHG157wH+PykNdbH0fonNRCRjKGqpe8=' 'sha256-IOSFaoadAQ+Di8VPYj3XAM7+UGTO7LL9xRUxiV0USWw=' 'sha256-RsFfe1cB5CoithqqCMWB6TkkhVy5LrPmoWZKEMnZwRg=' 'sha256-Kwex94XzLTST9G9mLForb+ndWB6SVRaMl6nKKoTLCFw=' 'sha256-garHAUeDcyTl2xo16BQPESvzqY36y/Tl3R/x+dUZa0U=' 'sha256-4fhOi4IWLR6Of8C4WDGKPRRA/13iDwHcdyYyfYhM4gk=' 'sha256-Nojvq9TThxA2tKREcDyA328Xu3hauXMOQeg3fAoSJhU=' 'sha256-ZZwnrKhKA0ZRtYiEbx4DVIEwKvKJmKGVCb3651zfzWU=' 'sha256-OzxBwiOrVtkkygYzETVZ0IeW1pv4XAQX4IYQ0lhnni8=' 'sha256-d1Afot0vOVf6GWkmy0u8ygfsTmI7G55s8KhyTs1yUck=' 'sha256-utC/goPBYUr8M36sSuJkWW4tqsGZHtL1jgaOoCMTtzc=' 'sha256-K2hZWmwaQRVjZW8AubUIKZFvh7dRx3tweo3EJLOUHJI='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /csp-report;" always;

    # HARDENING: modern security headers, same low-risk defense-in-depth as
    # the four above. This app never needs camera/mic/geolocation/payment
    # APIs, and has no legitimate cross-origin window references, so both are
    # safe to lock down fully rather than tune.
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Responses at "/" differ by Sec-Fetch-Dest (see the map at the top of
    # this file), so caches must not reuse the framed variant for an
    # ordinary visit, or the other way round.
    add_header Vary "Sec-Fetch-Dest" always;

    # HARDENING: rate limiting for the static homepage itself (index.html).
    # Deliberately looser than the "booking" zone below - see nginx.conf for
    # the rationale. This location has no other effect: root/index are still
    # inherited from the server block above, so "/" is served exactly as
    # before, just with a request cap per IP.
    location = / {
        limit_req zone=homepage burst=20 nodelay;
        limit_conn perip 20;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
        # Framed visitors get the script-free variant (see the map above);
        # everyone else gets index.html, and so does everyone if
        # index_embedded.html was never deployed.
        #
        # Deliberately NO add_header here: an add_header in a nested block
        # DROPS every add_header inherited from the server block, which
        # would silently serve the homepage with no CSP at all. The
        # matching `Vary: Sec-Fetch-Dest` therefore sits up at server level
        # with the other headers.
        try_files $index_variant /index.html =404;
    }

    ############################################################
    # When the app cannot answer
    ############################################################
    #
    # A stopped service (a deploy) or a crashed one makes every proxied
    # location below return nginx's stock "502 Bad Gateway" -- which tells
    # a guest nothing, and reads as "your booking is gone". This serves a
    # written page instead, with no script and no external asset: it is
    # shown exactly when the application is unavailable, so it must depend
    # on nothing but nginx and itself.
    #
    # `internal` keeps it un-linkable: it is reachable only as an error
    # page, never as a URL someone can visit or a search engine can index.
    error_page 502 503 504 /unavailable.html;
    location = /unavailable.html {
        internal;
    }

    ############################################################
    # Proxied booking app (Python, listening on 127.0.0.1:8811)
    ############################################################
    #
    # SELinux (enforcing by default on Fedora): nginx runs as the confined
    # httpd_t domain, which is NOT allowed to proxy_pass to an arbitrary local
    # port by default. Without this, every request through these blocks 502s
    # with an AVC denial (check `sudo ausearch -m avc -ts recent`), even though
    # the app itself is running fine:
    #   sudo setsebool -P httpd_can_network_connect on

    location /courses {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    location /book/ {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    # index.html's own <script> fetches this (public, read-only JSON --
    # see app/webapp.py::schedule_exceptions) to render the
    # schedule-exceptions ATTENTION banner client-side. Real bug hit in
    # production 2026-07-13: this location block didn't exist at all, so
    # nginx fell through to trying to serve /schedule-exceptions as a
    # static file under `root` and 404'd -- the banner could never work
    # regardless of anything on the app side. Same hardening as every
    # other proxied location here, nothing weaker.
    location /schedule-exceptions {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    # The browser's own CSP violation-report target (see this server
    # block's report-uri directive above and app/webapp.py::csp_report) --
    # POST-only, unauthenticated by design (it's the browser reporting on
    # itself). Same hardening as every other proxied location here: a
    # malicious flood of fake reports is still rate-limited/connection-
    # capped like anything else.
    location /csp-report {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    location /cancel/ {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    # the participant-facing counterpart to /cancel/ -- a canceled
    # booking's confirmation/reminder emails link here so a guest can undo
    # their own cancellation without logging in. Gated app-side by a
    # fresh, single-purpose hashed token minted at cancellation time, same
    # trust model as /cancel/'s own token -- same hardening (rate limit +
    # per-IP connection cap) as every other proxied location here, nothing
    # weaker.
    location /reinstate/ {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    # the calendar invite's per-occurrence "cancel:" line (see
    # app/calendar_sync.py) links here directly, so a host can cancel a
    # booking straight from their calendar app without logging into /admin
    # first. Gated app-side by registration_id being an unguessable uuid4,
    # not a separate hashed token like /cancel/'s own guest link -- same
    # hardening (rate limit + per-IP connection cap) as every other
    # proxied location here, nothing weaker.
    location /host-cancel/ {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    # the host-facing counterpart to /host-cancel/ -- the admin's own copy
    # of a cancellation email (and /admin's Reinstate button) links here
    # so a host can undo a cancellation straight from their inbox or their
    # calendar app without logging in first. Gated app-side by
    # registration_id being an unguessable uuid4, exactly the same trust
    # model as /host-cancel/ -- same hardening (rate limit + per-IP
    # connection cap) as every other proxied location here, nothing
    # weaker.
    location /host-reinstate/ {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    # "cancel the entire session" -- reachable from the operator's own
    # CalDAV event (see app/calendar_sync.py's "cancel entire session"
    # line), never from a guest-facing email. Same trust model as
    # /host-cancel/ (an unguessable-enough URL, no separate secret) --
    # same hardening as every other proxied location here.
    location /host-cancel-occurrence/ {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    location /my {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        limit_req zone=booking burst=10 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf
    }

    location /admin {
        proxy_pass http://127.0.0.1:8811;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # /admin has its own, looser zone (2026-08-27): it sits behind a
        # password AND the IP allowlist below, so per-IP flood limiting
        # buys little here -- while this is where the link-based
        # navigation is heaviest (each tab and "show more dates" is a page
        # load). REQUIRES the zone to exist in nginx.conf; without it
        # `nginx -t` refuses to load, which is the right failure: loud and
        # before the reload, not silent afterwards.
        limit_req zone=admin burst=30 nodelay;  # HARDENING: see nginx.conf for the zone definition/rationale
        limit_conn perip 10;  # HARDENING: caps simultaneous connections per IP, see nginx.conf

        # HARDENING (optional but recommended): restrict /admin to your own
        # known/dynamic IP(s), as defense-in-depth on top of the app's own
        # password login. nginx's allow/deny directives only accept literal
        # IPs/CIDRs, not hostnames -- REPLACE-ME: either hardcode your
        # static IP(s)/CIDR here (`allow 203.0.113.0/24; deny all;`), or set
        # up your own small script/cron job that resolves a dynamic-DNS
        # hostname you control and rewrites an included allow/deny file
        # (reloading nginx only if it actually changed and `nginx -t`
        # still passes). Remove this whole block if you don't want IP
        # restriction on /admin at all -- the app's own login still
        # applies regardless.
        #include global/admin-allow.conf;
    }
}

# HTTP -> HTTPS redirect for REPLACE-ME-YOUR-DOMAIN. This still uses
# certbot's original if-based idiom (left as-is, functionally fine and
# it's the standard pattern certbot itself generates) even though the
# comment at the top of this file says to avoid if-statements - that
# guidance was about avoiding if's for routing logic in general, not this
# specific narrow host-redirect case.
server {
    if ($host = REPLACE-ME-YOUR-DOMAIN) {
        return 301 https://$host$request_uri;
    }

    server_name REPLACE-ME-YOUR-DOMAIN;
    listen 80;
    return 404;
}
