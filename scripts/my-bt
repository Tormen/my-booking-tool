    gb.add_argument("--purge", action="store_true", help="actually delete rows past their retention window, instead of just listing them")
    format_arg(gb)
    gb.set_defaults(func=cmd_admin_gdpr_bookings)
    ga = _add_subcommand(
        gdpr_sub, "accounts", "list accounts and the date each reaches retention_months of inactivity.",
        "Add --purge to send any due warning emails and erase every account already past "
        "its deadline -- same job the nightly systemd timer runs.",
    )
    ga.add_argument("--purge", action="store_true", help="actually send due warnings and erase overdue accounts, instead of just listing them")
    format_arg(ga)
    ga.set_defaults(func=cmd_admin_gdpr_accounts)

    sp = _add_subcommand(
        admin_sub, "logout",
        "force-log-out an attendee (or --all for everyone) from the LIVE running service.",
        "2026-07-10, the operator: prompted by `setup -i`'s \"Restart my-booking.service now?\" "
        "step refusing to proceed while sessions are active (SESSIONS is in-memory -- a "
        "restart silently drops every one) -- this is the one-line fix it now points you "
        "at: clear them on purpose, then retry. Same effect as the RPM's own %pre gate "
        "before an upgrade. EMAIL logs out just that one attendee (every device); --all "
        "also clears any admin session.",
    )
    sp.add_argument("email_pos", nargs="?", metavar="EMAIL", help="attendee's login email (or use --all below)")
    sp.add_argument("--all", action="store_true", help="log out EVERY active session, guest and admin alike")
    sp.add_argument(
        "--internal-url", default=DEFAULT_INTERNAL_URL,
        help="base URL of the running app's own loopback listener (default: %(default)s, "
             "or $MY_BOOKING_INTERNAL_URL)",
    )
    sp.set_defaults(func=cmd_admin_logout)

    sp = _add_subcommand(
        admin_sub, "rename-course",
        "migrate registrations.csv + the calendar after renaming a course's shortname in settings.toml.",
        "Run AFTER settings.toml already has --to as a real [[course]] shortname -- "
        "this command does not edit settings.toml itself.",
    )
    sp.add_argument("--from", dest="from_", required=True, help="the OLD course shortname (must no longer be in settings.toml)")
