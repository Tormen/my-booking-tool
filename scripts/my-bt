    sp.add_argument("maintenance_command", choices=["on", "off", "status"], help="what to do")
    sp.add_argument("-m", "--message", help="optional message shown in the banner/booking pages (only used with 'on')")
    sp.set_defaults(func=cmd_maintenance)

    sp = _add_subcommand(
        admin_sub, "git-snapshot", "commit any data-dir changes now (same as the hourly timer).",
        "Useful right before a risky manual edit, so you have a rollback point. "
        "-m/--message: use this as the actual commit message instead of the "
        "auto-generated \"automatic snapshot: <timestamp>\" text, so the "
        "rollback point is named instead of just timestamped (ignored with "
        "--dry-run, since nothing is committed then).",
    )
    sp.add_argument("--dry-run", action="store_true", help="report what would be committed, without staging/committing")
    sp.add_argument("-m", "--message", help="custom commit message (default: \"automatic snapshot: <timestamp>\")")
    sp.set_defaults(func=cmd_git_snapshot)

    sp = _add_subcommand(
        admin_sub, "watchdog-check",
        "check nginx/app-log/signups/sshd for abuse patterns now (same as the periodic timer).",
        "Emails settings.admin_email ONE combined alert if anything fired -- not a dry run. "
        "Four independent checks, each silently skipped if its own setting/threshold is unset: "
        "(1) [watchdog].nginx_access_log -- one IP making too many requests, or too high a 4xx/5xx "
        "share, within window_minutes; cross-checked against fail2ban's own ban list. "
        "(2) [logging].log_file -- a burst of login/password-reset rate-limiter rejections. "
        "(3) registrations.csv (via the data dir) -- a burst of brand-new pending-confirmation "
        "signups, the shape a capacity-grab attempt would take. "
        "(4) sshd -- a burst of failed-password attempts, read via `journalctl -u sshd`. "
        "See app/watchdog.py's own module docstring for the full detail on all four.",
    )
    sp.set_defaults(func=cmd_admin_watchdog_check)

    sp = _add_subcommand(
        admin_sub, "setup", "show (or --interactive: be walked through) post-install setup steps.",
        "Plain `setup` only reports; add -i/--interactive to actually fix "
        "what's safely automatable (most of it needs root).",
    )
    sp.add_argument(
        "-i", "--interactive", action="store_true",
        help="actually walk through each step and perform what's safely automatable "
             "(most of it needs root)",
    )
    sp.set_defaults(func=cmd_setup)

    sp = _add_subcommand(
        admin_sub, "health",
        "full install-health diagnostic: settings/secrets/systemd/SELinux/nginx/... "
        "(this is what `my-bt status -V` used to be).",
        "Slower than plain `my-bt status` -- this is for diagnosing an "
        "install problem, not a quick liveness check.",
    )
    sp.set_defaults(func=cmd_admin_health)

    return p


def main() -> None:
    # 2026-07-08/09, the operator: zsh completion (see generate_zsh_completion's
    # own docstring above) -- generated at RPM %build time, not a real
    # user-facing subcommand, so this is checked directly against
    # sys.argv rather than added to build_parser()'s own subparsers
    # (keeps it out of `my-bt -h`'s command listing, and lets it work
    # standalone with no settings.toml/data-dir present, e.g. in a clean
    # rpmbuild chroot).
    if len(sys.argv) >= 2 and sys.argv[1] == "--print-zsh-completion":
        sys.stdout.write(generate_zsh_completion(build_parser()))
        return
    args = build_parser().parse_args()
    # 2026-07-09, the operator: bare `my-bt` or `my-bt admin` (any group needing a
    # further sub-command) should behave exactly like `-h`/`--help` --
    # full help, exit 0 -- not argparse's default required-subcommand
    # error. See build_parser()'s own comment on `_help_parser` for how
    # this gets set to whichever group parser parsing actually stopped
    # at. `func` is what every LEAF subcommand sets via set_defaults(); if
    # it's missing, no real command was ever chosen, so there's nothing
    # to run.
    if not hasattr(args, "func"):
        args._help_parser.print_help()
        sys.exit(0)
    # -D/--debug is just a per-invocation way to set MY_BOOKING_DEBUG=1
    # without needing to remember the env var (or touch the running
    # service's config) -- same single verbosity switch either way, see
    # app/logutil.py and README.md "Logs & debugging".
    if args.debug:
        os.environ["MY_BOOKING_DEBUG"] = "1"

    log_fh = None
    orig_stdout, orig_stderr = sys.stdout, sys.stderr
    log_path = app_config.peek_log_file(args.settings)
    if args.log:
        if not log_path:
            print("--log: no [logging].log_file configured in settings.toml -- "
                  "add one first, e.g.:", file=sys.stderr)
            print("  [logging]", file=sys.stderr)
            print('  log_file = "/var/lib/my-booking/my-booking.log"', file=sys.stderr)
        else:
            try:
                log_fh = open(log_path, "a", encoding="utf-8")
                # Tee installed *before* configure_logging() below, so its
                # StreamHandler (which reads sys.stderr at construction
                # time) picks up the Tee too -- covers print() output and
                # logging output with the one mechanism. See _Tee's
                # docstring.
                sys.stdout = _Tee(orig_stdout, log_fh)
                sys.stderr = _Tee(orig_stderr, log_fh)
                print(f"=== my-bt {' '.join(sys.argv[1:])} "
                      f"@ {datetime.now(timezone.utc).isoformat()} ===")
            except OSError as exc:
                print(f"--log: could not open {log_path!r} ({exc}); "
                      "continuing without it", file=sys.stderr)
                log_fh = None

    # 2026-07-14 fix: this used to call configure_logging() with no
    # log_file at all, so a configured [logging].log_file was silently
    # never honored by ANY `my-bt` invocation -- harmless while the
    # systemd timers called `python3 -m app.retention`/`app.git_snapshot`/
    # `app.watchdog` directly (each of those modules' own main() calls
    # configure_logging(settings.log_file) itself), but the same day's
    # restructure to have every timer call `my-bt admin ...` instead (see
    # systemd/my-booking-*.service) bypasses those main()s entirely --
    # cmd_admin_gdpr_bookings/cmd_admin_gdpr_accounts/cmd_git_snapshot/
    # cmd_admin_watchdog_check all call the underlying function directly,
    # never that module's main(). Caught while answering the operator's question
    # "does my-bt log anything into journal otherwise?"
    #
    # log_fh is not None only when -L/--log successfully opened THE SAME
    # log_path and installed the Tee above -- in that case configure_
    # logging()'s own StreamHandler already reaches that file via the Tee
    # (see _Tee's docstring), so passing log_file too would add a second,
    # independent FileHandler onto the identical path and double every
    # log line. Pass it through otherwise (plain invocations, and every
    # systemd-timer invocation, none of which use -L).
    debug = configure_logging(None if log_fh is not None else log_path)
    try:
        args.func(args)
    except KeyboardInterrupt:
        # Ctrl-C during a prompt (e.g. `setup -i`'s "Merged? Remove
        # ...rpmnew now? [y/N]") is a normal, expected way to bail out --
        # not a crash, so it never gets a traceback, even with --debug.
        print("\nAborted (Ctrl-C).", file=sys.stderr)
        sys.exit(130)  # 128 + SIGINT, the conventional shell exit code
    except Exception as exc:
        if debug:
            raise
        print(f"error: {exc}", file=sys.stderr)
        print("(re-run with --debug for the full traceback)", file=sys.stderr)
        sys.exit(1)
    finally:
        # Restore the real streams *before* closing the file -- otherwise
        # Python's own shutdown-time flush of sys.stdout/stderr writes to
        # the Tee after log_fh is closed, raising "I/O operation on closed
        # file" from an unraisable-exception hook (harmless but alarming
        # noise on every --log run; seen in practice while testing this).
        sys.stdout, sys.stderr = orig_stdout, orig_stderr
        if log_fh:
            log_fh.close()


if __name__ == "__main__":
    main()
