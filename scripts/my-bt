#!/usr/bin/env python3
"""my-bt (my-booking-tool) -- CLI for querying and managing my-booking-tool's
CSV data (live + archived), running the retention purge on demand, erasing a
user's data manually (GDPR Art. 17), and running the test suite.

Installed at /opt/my-booking/bin/my-bt, symlinked from /usr/local/bin/my-bt
so it's on PATH (see packaging/my-booking-tool.spec). Add your login to the
`my-booking` group (`sudo usermod -aG my-booking <you>`) so you can read
the data files without sudo.

Run `my-bt --help` or `my-bt <command> --help` for full option lists.
"""
from __future__ import annotations

import argparse
import csv
import getpass
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import asdict
from datetime import date, datetime, timezone
from pathlib import Path

HOME = os.environ.get("MY_BOOKING_HOME", "/opt/my-booking")
sys.path.insert(0, HOME)

try:
    from app import calendar_sync as app_calendar_sync
    from app import cancel_flow as app_cancel_flow
    from app import cli_cancel as app_cli_cancel
    from app import cli_list as app_cli_list
    from app import cli_show as app_cli_show
    from app import cli_stats as app_cli_stats
    from app import config as app_config
    from app import erasure as app_erasure
    from app import git_snapshot as app_git_snapshot
    from app import retention as app_retention
    from app import security as app_security
    from app import version as app_version
    from app import watchdog as app_watchdog
    from app.logutil import configure_logging
    from app.storage import Store, User
except ImportError as exc:  # pragma: no cover
    print(f"error: could not import the app package from {HOME} ({exc}).", file=sys.stderr)
    print("Set MY_BOOKING_HOME if it's installed somewhere else.", file=sys.stderr)
    sys.exit(1)

# Deliberately NOT HOME-relative: HOME (/opt/my-booking) is the app's code
# directory, but settings.toml is real config, so it lives under
# /etc/my-booking alongside secrets/ (moved there from /opt/my-booking on
# 2026-07-05 -- see the maintainer's local notes; the two were only ever coupled by
# accident, nothing about the code required it).
DEFAULT_SETTINGS = os.environ.get("MY_BOOKING_SETTINGS", "/etc/my-booking/settings.toml")
DEFAULT_DATA_DIR = os.environ.get("MY_BOOKING_DATA", "/var/lib/my-booking")

# The running app only ever listens on 127.0.0.1:8811 (see app/serve.py's
# --host/--port defaults and systemd/my-booking.service's ExecStart, which
# never overrides either) -- `my-bt status` queries this directly, on the
# same host, bypassing nginx entirely (see app/webapp.py's internal_status()
# and its module docstring for the full trust model). Overridable for the
# unusual case of a non-default --port at serve.py startup.
DEFAULT_INTERNAL_URL = os.environ.get("MY_BOOKING_INTERNAL_URL", "http://127.0.0.1:8811")


def _store(args) -> Store:
    return Store(args.data_dir)


def _print_rows(rows: list[dict], fmt: str) -> None:
    if not rows:
        print("(no matching rows)")
        return
    if fmt == "json":
        print(json.dumps(rows, indent=2))
        return
    if fmt == "csv":
        writer = csv.DictWriter(sys.stdout, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)
        return
    # table
    cols = list(rows[0].keys())
    widths = {c: max(len(c), *(len(str(r.get(c, ""))) for r in rows)) for c in cols}
    header = "  ".join(c.ljust(widths[c]) for c in cols)
    print(header)
    print("-" * len(header))
    for r in rows:
        print("  ".join(str(r.get(c, "")).ljust(widths[c]) for c in cols))


def _print_single_row_kv(row: dict, fmt: str) -> None:
    """Vertical 'key : value' layout for exactly ONE entity (a single
    registration, a course's own settings.toml definition, a user's own
    profile row) -- 2026-07-09, the operator, on a 14-column registration
    wrapping illegibly across the terminal in the normal horizontal
    _print_rows table: "show works on a single entity -> please use more
    human friendly output ... a simple: key : value table". json/csv stay
    exactly as they already were (already machine-readable, nothing to
    fix there); only the default 'table' format gets this treatment.
    Multi-row `show` results (an occurrence with several bookings,
    ambiguous matches, a user's own booking history) stay on the existing
    horizontal _print_rows table -- a vertical layout only helps when
    there's exactly one row; several side by side is what a table is
    for."""
    if fmt in ("json", "csv"):
        _print_rows([row], fmt)
        return
    if not row:
        print("(no data)")
        return
    width = max(len(str(k)) for k in row)
    for k, v in row.items():
        print(f"{str(k).ljust(width)} : {v}")


def _in_range(value: str, start: str | None, end: str | None) -> bool:
    if start and value < start:
        return False
    if end and value > end:
        return False
    return True


class _Tee:
    """Duplicates writes to the original stream and a log file. Used by
    -L/--log: install this on sys.stdout/sys.stderr *before* calling
    configure_logging(), so logging's own StreamHandler (which reads
    sys.stderr at construction time) picks up the Tee too -- one
    mechanism covers both plain print() output and log records, instead
    of needing a separate logging.FileHandler as well."""

    def __init__(self, stream, fh):
        self._stream = stream
        self._fh = fh

    def write(self, data):
        self._stream.write(data)
        self._fh.write(data)
        self._fh.flush()

    def flush(self):
        self._stream.flush()
        self._fh.flush()


# -- subcommands --------------------------------------------------------------

def cmd_list(args) -> None:
    """`my-bt list` -- query registrations. Default: today + future, live
    only. --all: every date, live + archived (any live user's pre-erasure
    archived history is merged in on the fly here -- see
    app.cli_list.merge_archived_for_display -- WITHOUT writing anything
    to disk; use `my-bt admin dearchive` to actually persist a merge).
    --past: same merge, occurrence_date strictly before today only.

    2026-07-13: this is also what `my-bt history` used to be for (dropped
    -- folded in here instead): `list --all --email x@y.com` shows an
    attendee's full history, live and pre-erasure combined, the same "N
    (incl. M pre-erasure)" merge /admin's overview shows.

    2026-07-13, the operator: "the default command shows it cleant up without
    technical ids ... can you mimick the view of the web-interface?" --
    default output is close to /admin's own table (see
    app.cli_list.build_clean_registration_view -- Times booked/Guests are
    the SAME shared helpers admin_overview() itself now calls, so the
    numbers/wording can't drift between the two), but Date leads (2026-
    07-08, the operator: "put this as first column") and Registered/Guests are
    both hidden unless -V/--verbose is passed (same the operator message: "don't
    show when they registered by default but only with my-bt list -V";
    Guests followed same day: "the 'guests' here is additional fluff as
    any guest will have their own line here" -- true, each party member
    is already its own row) -- default columns: Date, Id, Status, Course,
    Name, Email, Times booked. Rows are always sorted by occurrence_date
    (then course) regardless of -V/-r/--format.

    Pass -r/--raw for the original full raw-CSV-column view (every field
    Store.read_registrations returns, plus a "party" column -- see
    app.cli_list.annotate_party_info, a separate, older, lowercase format
    from the clean view's "Guests" column, left unchanged for anyone
    already scripting against -r's output)."""
    store = _store(args)
    settings = app_config.load_settings(args.settings)
    live_regs = store.read_registrations(scope="live")
    users = {u["user_id"]: u for u in store.read_users(scope="all")}

    # Archived pre-erasure history, merged onto the live user_id it
    # belongs to (display-only -- see merge_archived_for_display's own
    # docstring). Computed unconditionally, same as admin_overview()'s own
    # all_regs: Times booked's TOTAL must reflect an attendee's true lifetime
    # count even when the rows actually displayed are narrowed to
    # today+future.
    archived_merged = app_cli_list.merge_archived_for_display(
        store, settings, store.read_users(scope="live"), store.read_registrations(scope="archived")
    )
    all_rows_for_totals = live_regs + archived_merged

    today_iso = date.today().isoformat()
    if args.all:
        rows = all_rows_for_totals
    elif args.past:
        rows = [r for r in all_rows_for_totals if r["occurrence_date"] < today_iso]
    else:
        rows = [r for r in live_regs if r["occurrence_date"] >= today_iso]

    if args.year:
        args.from_ = args.from_ or f"{args.year}-01-01"
        args.to = args.to or f"{args.year}-12-31"
    if args.course:
        rows = [r for r in rows if r["course_shortname"] == args.course]
    if args.status:
        rows = [r for r in rows if r["status"] == args.status]
    if args.user_id:
        rows = [r for r in rows if r["user_id"] == args.user_id]
    if args.from_ or args.to:
        rows = [r for r in rows if _in_range(r["occurrence_date"], args.from_, args.to)]
    if args.email:
        needle = args.email.strip().lower()
        rows = [
            r for r in rows
            if needle in users.get(r["user_id"], {}).get("email", "").lower()
        ]

    rows.sort(key=lambda r: (r["occurrence_date"], r["course_shortname"]))

    if args.raw:
        rows = app_cli_list.annotate_party_info(rows, users)
        _print_rows(rows, args.format)
        return

    # Short ids (2026-07-13, the operator: "a bit like what git does with its
    # commit ids") are only ever assigned over LIVE registrations -- the
    # same universe `my-bt cancel`'s short-id resolution searches (see
    # cmd_cancel), since only a live row can actually be canceled by one.
    # An archived row shown in this same `list` output (--all/--past)
    # just gets a blank "id" cell.
    live_ids = [r["registration_id"] for r in live_regs]
    short_ids = app_cli_list.assign_short_ids(live_ids)
    clean = app_cli_list.build_clean_registration_view(
        rows, users, all_rows_for_totals, date.today(),
        short_ids_by_reg_id=short_ids, verbose=args.verbose,
    )
    _print_rows(clean, args.format)


def cmd_users(args) -> None:
    """`my-bt users` -- list attendee accounts across live/archived/all.
    2026-07-08, the operator: "I have no guests, I have clients or participants
    in a yoga course. guest is who they can bring." -- "attendee" for the
    account/person themselves, "guest" reserved for the +1 they bring
    (party_id/invited_by_user_id -- see app.cli_list's own Guests column,
    unchanged).

    2026-07-13: default output is a compact, readable view -- see
    app.cli_list.build_clean_user_view. Pass -r/--raw for every raw
    column (password/token hashes and all -- pin_hash/pin_salt are still
    stripped either way, see below).

    2026-07-08, the operator: "please have name joined last_login last_course
    email" (email now last, not 2nd), "last_course = last confirmed
    course" (new column, computed from ALL registrations regardless of
    this command's own --live/--archive scope -- see
    app.cli_list.compute_last_confirmed_course), "please only make email
    as wide as needed!" (erased users' hashed email is now shown as
    "[erased]" instead of the raw ~70-char hash), and "please only use
    YYYY-MM-DD for the columns and only with -V show also the
    timestamp" -- see -V/--verbose below.

    2026-07-14, the operator, changing the DEFAULT scope (bare `my-bt users`,
    no flags): "actually no: by default my-bt users should show --live
    users that logged in (that has a last_login date) Then you add --all
    to show both --live and --archived" -- confirmed exact semantics
    after a follow-up: "--live shows ALL live users also the ones that
    have no login date / --archive shows only the archived users / --all
    shows both / it all makes sense, no?" So: --live/--archive are
    UNCHANGED from before (every live row, or every archived row, no
    login filter either way); --all is the old bare-default behavior
    (live+archived combined, still no login filter); and the new bare
    default (args.scope is None here) is the one truly new view -- live
    accounts that have actually logged in at least once, a narrower
    subset of --live. See the `users` subparser's own --all/--live/
    --archive registration below for the argparse side of this.

    2026-07-10, the operator: "already shows last_login! so lets add a column:
    session still active?" -- only meaningful for the clean (non-raw)
    view, so the live /internal/status query (same one `my-bt status`
    itself makes, see _query_internal_status) only happens when we're
    actually about to build that view; a plain -r/--raw dump stays a
    pure CSV read with no network dependency, same as before. See
    app.cli_list.build_clean_user_view's own docstring for what a query
    failure renders as ("(unknown)", not a false "(offline)").

    Also see `my-bt users logout` below (same message: "lets add 'logout
    <EMAIL>' and 'logout --all' as possibilities to my-bt users") --
    the actual command stays `my-bt admin logout` (the operator, on where it
    should live: "we have BOTH"), this is just also reachable from here."""
    store = _store(args)
    if args.scope is None:
        rows = [r for r in store.read_users(scope="live") if r.get("last_login_at")]
    else:
        rows = store.read_users(scope=args.scope)
    if args.email:
        needle = args.email.strip().lower()
        rows = [r for r in rows if needle in r["email"].lower()]
    rows = [{k: v for k, v in r.items() if k not in ("pin_hash", "pin_salt")} for r in rows]
    if not args.raw:
        last_course = app_cli_list.compute_last_confirmed_course(
            store.read_registrations(scope="all"), date.today(),
        )
        payload, _error = _query_internal_status(args.internal_url)
        active_sessions = (
            {s["who"].lower() for s in payload.get("sessions", []) if s.get("kind") == "guest"}
            if payload else None
        )
        rows = app_cli_list.build_clean_user_view(
            rows, last_course_by_user=last_course, verbose=args.verbose, active_sessions=active_sessions,
        )
    _print_rows(rows, args.format)


def _show_registration_by_full_id(full_id: str, store, users_by_id: dict, fmt: str) -> None:
    """Shared by every path that ends up resolving to one specific
    registration_id (auto-detected or via a resolved short id) -- full
    detail, "party" column (app.cli_list.annotate_party_info) computed
    across ALL rows in that row's scope first (so a sibling party member
    elsewhere in the file is actually found), then narrowed to just the
    requested row. 2026-07-09, the operator, on this wrapping illegibly across
    the terminal as a 14-column ONE-row table: printed as a vertical
    key : value listing instead (see _print_single_row_kv)."""
    for scope in ("live", "archived"):
        rows = app_cli_list.annotate_party_info(store.read_registrations(scope=scope), users_by_id)
        for r in rows:
            if r["registration_id"] == full_id:
                _print_single_row_kv({**r, "_scope": scope}, fmt)
                return
    print("not found", file=sys.stderr)
    sys.exit(1)


def _show_course(course, fmt: str) -> None:
    """The course's own static settings.toml definition -- title,
    location, weekday/time, duration, capacity, etc. Deliberately NOT a
    live occurrence computation (that needs CalDAV conflict-checking,
    see app/slots.py::build_occurrences) -- `my-bt list`/the booking
    website already show live upcoming occurrences; this is specifically
    "what IS this course configured as". One row -> vertical key : value
    listing, same reasoning as _show_registration_by_full_id above."""
    _print_single_row_kv(asdict(course), fmt)


def _show_occurrence(rows: list[dict], users_by_id: dict, all_rows: list[dict], fmt: str) -> None:
    """One or more registrations sharing an occurrence_date (2026-07-08,
    the operator: `show <date>` -- possibly more than one course meets on the
    same date, all shown together, each row's own "course" column makes
    that unambiguous to read). Same clean columns `my-bt list` uses, NOT
    narrowed to live-only (a lookup, not an action) -- no short "id"
    column here though, since these rows can be a live/archived mix and
    a short id is only ever assigned over the live universe (see
    assign_short_ids's own docstring)."""
    clean = app_cli_list.build_clean_registration_view(rows, users_by_id, all_rows, date.today(), verbose=True)
    _print_rows(clean, fmt)


def _show_user(user_row: dict, store, fmt: str) -> None:
    """One attendee's profile (build_clean_user_view, same shape `my-bt
    users` shows) plus their full booking history. A user_id is stable
    across the live/archived boundary (erase_user() only ever mutates
    name/email, never user_id -- see app/storage.py) so this user_row's
    OWN registrations are already fully found via a plain scope="all"
    read; no archived-history merge needed here (that's a DIFFERENT
    scenario -- re-attaching a DIFFERENT, now-orphaned archived user_id
    onto a NEW live one after an attendee re-registers post-erasure, see
    merge_archived_for_display's own docstring). The profile itself is one
    row -> vertical key : value listing, same reasoning as
    _show_registration_by_full_id above; the booking history below it is
    genuinely multi-row, so that part stays on the horizontal table."""
    all_regs = store.read_registrations(scope="all")
    last_course = app_cli_list.compute_last_confirmed_course(all_regs, date.today())
    profile = app_cli_list.build_clean_user_view([user_row], last_course_by_user=last_course, verbose=True)
    print("-- profile --")
    _print_single_row_kv(profile[0], fmt)
    own_rows = [r for r in all_regs if r["user_id"] == user_row.get("user_id")]
    own_rows.sort(key=lambda r: r["occurrence_date"])
    print("-- booking history --")
    if own_rows:
        users_by_id = {u["user_id"]: u for u in store.read_users(scope="all")}
        _show_occurrence(own_rows, users_by_id, all_regs, fmt)
    else:
        print("(no registrations)")


def _report_ambiguous(label: str, rows: list[dict], fmt: str) -> None:
    print(f"{len(rows)} {label} match -- be more specific:", file=sys.stderr)
    _print_rows(rows, fmt)
    sys.exit(1)


def cmd_show(args) -> None:
    """`my-bt show <query>` -- shows ANY entity: a registration/booking,
    a course, a course-occurrence, or a user, auto-detected from ONE
    free-form `query` (2026-07-08, the operator: "show should be used to show
    any entity! this can be a booking or a course or a course-occurance
    or a user"), OR force a specific type with --course/--user (same
    day: "keep the explicit parameters like --course and --user to FORCE
    a specific type if needed").

    Auto-detection order (see app.cli_show.classify_show_query for the
    full rationale): (1) exact full registration_id; (2) a short id (see
    `my-bt list`'s own "id" column) -- ONLY tried if `query` actually
    looks id-shaped, so an ordinary search term is never mistaken for
    one; (3) an exact course shortname; (4) every registration on a
    YYYY-MM-DD date, any course; (5) a name/email substring search
    across attendees -- same "type part of it" search the web admin's own
    table filter offers. First rule that matches wins.

    --course alone shows that course's own settings.toml definition;
    --course --date shows that one occurrence (same as auto-detecting a
    bare date, but pre-narrowed to one course, for when more than one
    course meets on the same date). --user forces the name/email search
    directly, skipping every other check.

    Searches live+archived combined throughout -- `show` is a read-only
    lookup, not a mutating action (unlike `my-bt cancel`, which stays
    live-only on purpose)."""
    store = _store(args)
    settings = app_config.load_settings(args.settings)
    users_by_id = {u["user_id"]: u for u in store.read_users(scope="all")}
    all_rows = store.read_registrations(scope="all")

    if args.course:
        course_matches = app_cli_show.find_course_by_shortname(args.course, settings.courses)
        if not course_matches:
            print(f"no course with shortname {args.course!r}", file=sys.stderr)
            sys.exit(1)
        course = course_matches[0]
        if args.date:
            rows = [
                r for r in all_rows
                if r["course_shortname"] == course.shortname and r["occurrence_date"] == args.date
            ]
            if not rows:
                print(f"no registrations for {course.shortname} on {args.date}", file=sys.stderr)
                sys.exit(1)
            _show_occurrence(rows, users_by_id, all_rows, args.format)
            return
        _show_course(course, args.format)
        return

    if args.user:
        matches = app_cli_show.find_users_by_name_or_email(args.user, list(users_by_id.values()))
        if not matches:
            print("no matching user", file=sys.stderr)
            sys.exit(1)
        if len(matches) > 1:
            _report_ambiguous("users", app_cli_list.build_clean_user_view(matches), args.format)
            return
        _show_user(matches[0], store, args.format)
        return

    if not args.query:
        # 2026-07-09, the operator: "Why does my-bt show not show the --help like
        # the others?" -- query/--course/--user are all optional (a
        # mutually exclusive group, none required), so argparse itself
        # never errors on a bare `my-bt show` the way it does for e.g.
        # `my-bt cancel` (whose query/--id/--date group IS required) --
        # this used to print a bespoke one-line stderr
        # message instead of real help. Same fix as bare `my-bt`/`my-bt
        # admin` (see build_parser()'s own `_help_parser` comment): full
        # help, exit 0, for consistency across every command.
        args._help_parser.print_help()
        sys.exit(0)

    full_ids = [r["registration_id"] for r in all_rows]
    kind, data = app_cli_show.classify_show_query(
        args.query, full_ids, settings.courses, list(users_by_id.values()), all_rows,
        min_id_length=app_cli_list.SHORT_ID_LENGTH,
    )
    if kind == "registration":
        _show_registration_by_full_id(data, store, users_by_id, args.format)
    elif kind == "ambiguous_registration":
        print(f"{len(data)} registrations match -- be more specific:", file=sys.stderr)
        for fid in data:
            print(f"  {fid}", file=sys.stderr)
        sys.exit(1)
    elif kind == "course":
        _show_course(data, args.format)
    elif kind == "occurrence":
        _show_occurrence(data, users_by_id, all_rows, args.format)
    elif kind == "user":
        _show_user(data, store, args.format)
    elif kind == "ambiguous_user":
        _report_ambiguous("users", app_cli_list.build_clean_user_view(data), args.format)
    else:
        print("not found", file=sys.stderr)
        sys.exit(1)


def cmd_stats(args) -> None:
    """`my-bt stats` -- one row per (course, status): a "total" column
    (renamed from "count" -- 2026-07-08, the operator: "I just meant to rename
    'count' to total count or just total", clarifying that this table's
    shape was never meant to change), plus, as extra columns on that SAME
    row (2026-07-08, the operator: "I just meant to add them as ADDITIONAL
    columns to the existing table! Hence you will have this info per
    status listed"): last/next occurrence counts and a year-over-year
    comparison, each computed for that exact (course, status) -- not
    confirmed-only, not course-only. "total" itself is also "count/
    distinct" (2026-07-08, the operator: "and total should also have
    count/distinct please"), same as the year-over-year columns. See
    app/cli_stats.py for the actual computation (kept there, not here,
    so it's unit-testable).

    --year/--scope only ever restrict the "total" column, same as before
    this existed -- the last/next-slot and year-over-year columns are
    each about their OWN fixed window/date already, so narrowing them by
    an unrelated --year would just be confusing (e.g. "last year to
    date" under `--year 2020` makes no sense). They're computed off
    live+archived combined regardless of --scope too, so a since-erased
    attendee's own history still counts."""
    store = _store(args)
    rows = store.read_registrations(scope=args.scope)
    if args.year:
        rows = [r for r in rows if r["occurrence_date"].startswith(str(args.year))]
    totals = app_cli_stats.compute_totals_with_distinct(rows)

    all_rows = store.read_registrations(scope="all")
    slots = app_cli_stats.compute_last_and_next_slot(all_rows)
    year_stats = app_cli_stats.compute_year_period_stats(all_rows)

    out = []
    for course, status in sorted(totals):
        key = (course, status)
        slot = slots.get(key, {})
        last_slot = slot.get("last_slot")
        next_slot = slot.get("next_slot")
        years = year_stats.get(key, {})
        out.append({
            "course": course,
            "status": status,
            "total": _fmt_count_distinct(totals[key]),
            "last slot": last_slot[1] if last_slot else "",
            "next slot": next_slot[1] if next_slot else "",
            "last year": _fmt_count_distinct(years.get("last_year")),
            "last year to date": _fmt_count_distinct(years.get("last_year_to_date")),
            "this year to date": _fmt_count_distinct(years.get("this_year_to_date")),
        })
    _print_rows(out, args.format)


def _fmt_count_distinct(count_distinct: tuple[int, int] | None) -> str:
    """"count/distinct" for a year-over-year cell -- 2026-07-08, the operator:
    "add to each count a /xx where xx is the number of disjunct
    participants in this period" -- "0/0" (not blank) for a (course,
    status, window) with nothing in it, so the column stays numeric/
    sortable in --format csv rather than mixing in empty strings."""
    if count_distinct is None:
        return "0/0"
    count, distinct = count_distinct
    return f"{count}/{distinct}"


def cmd_hash_password(args) -> None:
    """`my-bt hash-password` -- prompts for the admin login password (hidden
    input -- never typed into a command line, so it never ends up in shell
    history or `ps`) and prints the hash to put in
    /etc/my-booking/secrets/admin_password_hash. That file must contain
    this HASH, never the plain password -- `my-bt status` specifically
    checks for and flags that exact mistake."""
    pw1 = getpass.getpass("Admin password: ")
    pw2 = getpass.getpass("Confirm: ")
    if not pw1:
        print("error: empty password, nothing generated", file=sys.stderr)
        sys.exit(1)
    if pw1 != pw2:
        print("error: passwords didn't match, nothing generated", file=sys.stderr)
        sys.exit(1)
    print(app_security.hash_admin_password(pw1))


def cmd_erase(args) -> None:
    """`my-bt admin gdpr erase EMAIL` (or `--email EMAIL`) -- manual
    right-to-erasure (Art. 17). Cancels any future confirmed/waitlisted
    bookings for this email and moves their user + registration rows into
    data/archived/*.csv with the email irreversibly hashed. Also promotes
    the next waitlisted person (if a cancellation here freed a confirmed
    spot) and re-syncs the calendar for every affected occurrence, via
    app.cancel_flow.cancel_and_promote -- the SAME shared logic every
    other cancellation path uses (2026-07-06: this used to skip calendar
    sync entirely; that gap is closed now, same as `my-bt cancel`). This
    means this command has a real network/CalDAV dependency and can
    fail/take longer if the CalDAV server is unreachable.

    2026-07-16, the operator: "--email should be optional here simply, my-bt
    admin erase operator@example.org should work as well" -- the email can now
    be given as a plain positional argument (`email_pos`) instead of
    always needing `--email` spelled out; both are accepted (an
    explicit --email still works, e.g. for a script that already used
    it), and giving BOTH with conflicting values is rejected rather than
    silently picking one."""
    email = args.email_pos or args.email_flag
    if args.email_pos and args.email_flag and args.email_pos != args.email_flag:
        print(
            f"error: got two different emails -- {args.email_pos!r} (positional) vs "
            f"{args.email_flag!r} (--email) -- pass just one",
            file=sys.stderr,
        )
        sys.exit(1)
    if not email:
        print("error: an email is required -- `my-bt admin gdpr erase EMAIL` or `--email EMAIL`", file=sys.stderr)
        sys.exit(1)
    if not args.yes:
        confirm = input(f"Erase all data for {email}? Type 'yes' to confirm: ")
        if confirm.strip().lower() != "yes":
            print("aborted")
            return
    settings = app_config.load_settings(args.settings)
    store = _store(args)
    caldav = app_cancel_flow.build_caldav_client(settings)
    ok = app_erasure.erase_user_by_email(store, settings, email, today=date.today(), caldav=caldav)
    print("erased" if ok else "no such user (nothing to erase)")


# 2026-07-14, the operator: "lets remove this command from my-bt admin please as
# this is a clear GDPR violation" -- `my-bt admin dearchive` (formerly
# `my-bt merge`) used to permanently re-attach an erased identity's
# pre-erasure booking history onto a live, identifiable account, i.e.
# deliberately re-linking data that Art. 17 erasure had de-linked.
# Removed entirely -- app.cli_history.run_merge/MergeResult and
# Store.merge_archived_registrations() (the only things that ever called
# it) are gone too, see their own removal. The READ-ONLY equivalent
# (on-the-fly, nothing persisted -- `/admin` and `my-bt list --all`/
# `--past` via app.cli_list.merge_archived_for_display) explicitly stays;
# the operator: "the implicit functionality of this baked into /admin and my-bt
# list should stay."


def cmd_admin_rename_course(args) -> None:
    """`my-bt admin rename-course --from OLD --to NEW` -- migrates
    existing data after a course's shortname changes in settings.toml
    (2026-07-08, the operator: "rename lux-wed-mindfulness to lux-wed-mind ...
    provide a command to migrate the existing data AFTER I installed
    this change"). Run this AFTER settings.toml already has --to as a
    real [[course]] shortname -- this command does NOT edit
    settings.toml itself.

    Two things happen, in order:
    1. Every registration row (live + archived) with course_shortname
       --from is rewritten to --to (Store.rename_course_shortname).
    2. Any upcoming occurrence that already had a live calendar event
       under the OLD shortname gets that stale event deleted and a
       fresh one created under the NEW shortname
       (app.calendar_sync.resync_after_course_rename) -- renaming
       changes the calendar event's UID (the shortname is baked
       directly into it, see event_uid's own docstring), so skipping
       this step would leave a duplicate, orphaned event sitting on the
       calendar for every such occurrence forever, alongside a fresh one
       the next booking/cancellation would silently create under the
       new UID.

    Has a real CalDAV/network dependency for step 2 and can fail/take
    longer if the CalDAV server is unreachable -- step 1 (the CSV
    migration) has already completed by that point regardless, so a
    step-2 failure is safe to just retry (Store.rename_course_shortname
    is a no-op the second time, since no rows are left under --from)."""
    settings = app_config.load_settings(args.settings)
    if settings.course(args.to) is None:
        print(
            f"error: no course with shortname {args.to!r} in settings.toml -- "
            "update settings.toml's [[course]] shortname to --to BEFORE running this",
            file=sys.stderr,
        )
        sys.exit(1)
    if settings.course(args.from_) is not None:
        print(
            f"error: settings.toml still has a course with shortname {args.from_!r} -- "
            "finish renaming it to --to in settings.toml first",
            file=sys.stderr,
        )
        sys.exit(1)

    store = _store(args)
    changed = store.rename_course_shortname(args.from_, args.to)
    print(f"{changed} registration row(s) migrated from {args.from_!r} to {args.to!r}")
    if changed == 0:
        return

    caldav = app_cancel_flow.build_caldav_client(settings)
    href = app_cancel_flow.calendar_href(caldav, settings)
    fixed = app_calendar_sync.resync_after_course_rename(
        caldav, href, store, settings, args.from_, args.to, today=date.today(),
    )
    print(f"{fixed} upcoming occurrence(s) had their calendar event moved to the new calendar UID")


def cmd_admin_resync_calendar(args) -> None:
    """`my-bt admin resync-calendar` -- re-syncs every course's future
    occurrence that currently has a live calendar entry, recomputing each
    one's description from scratch. Run this once, by hand, any time
    `app.calendar_sync.sync_occurrence()`'s own description format
    changes (see that function's own docstring, and SOLUTION-DESIGN.md's
    standing note on this) -- 2026-07-09, the operator, on noticing a real
    occurrence's invite was still missing the "cancel entire session"
    line added days earlier: "please ensure that the existing (future)
    calendar invites are updated as well." Only the operator's OWN CalDAV
    event is ever touched here -- an already-emailed guest's personal
    .ics attachment can't be retroactively edited; see
    app.calendar_sync.resync_all_future_calendar_events's own
    docstring."""
    settings = app_config.load_settings(args.settings)
    caldav = app_cancel_flow.build_caldav_client(settings)
    href = app_cancel_flow.calendar_href(caldav, settings)
    result = app_calendar_sync.resync_all_future_calendar_events(
        caldav, href, _store(args), settings, today=date.today(),
    )
    app_calendar_sync.record_resync_skips(args.data_dir, result)
    print(f"{result.fixed} upcoming occurrence(s) re-synced")
    if result.skipped:
        # 2026-07-15/16, the operator, from a real run where this went unnoticed
        # entirely: a persistent CalDAV conflict must be loud here, not
        # just a WARNING line in the log -- and this command must exit
        # nonzero so a script/cron wrapper actually notices too, same
        # "any warning -> exit 1" policy as `admin setup`/`admin health`.
        print(f"{len(result.skipped)} occurrence(s) FAILED to resync (persistent CalDAV conflict):")
        for line in result.skipped:
            print(f"  - {line}")
        sys.exit(1)


def _cmd_cancel_occurrence(args, settings, store) -> None:
    """`my-bt cancel --date ...` -- the mass-cancel branch factored out of
    cmd_cancel() so that function's own docstring/single-row logic stays
    readable. Auto-detects --course from the date's own live cancelable
    registrations when not given (see cmd_cancel's own docstring for why
    that's the common case), then runs the exact same
    app.cancel_flow.cancel_occurrence every other "cancel the entire
    session" path (the /admin checkbox, /host-cancel-occurrence) uses."""
    course_shortname, candidates = app_cli_cancel.resolve_course_shortname_for_date(store, args.date, args.course)
    if course_shortname is None:
        if candidates:
            print(f"ambiguous course for {args.date} -- {len(candidates)} courses have live registrations:")
            for c in candidates:
                print(f"  {c}")
            print("pass --course to pick one.")
        else:
            print(f"no live registrations found on {args.date} -- nothing to cancel")
        return

    participants = app_cancel_flow.find_cancelable_registrations_for_occurrence(store, course_shortname, args.date)
    if not participants:
        print(f"no live registrations for {course_shortname} on {args.date} -- nothing to cancel")
        return

    if not args.yes:
        print(f"About to cancel EVERY registration for {course_shortname} on {args.date}:")
        for r in participants:
            user = store.find_user_by_id(r.user_id)
            who = f"{user.name} <{user.email}>" if user else "(unknown attendee)"
            print(f"  {who} ({r.status})")
        confirm = input(f"{len(participants)} participant(s) will be notified. Type 'yes' to confirm: ")
        if confirm.strip().lower() != "yes":
            print("aborted")
            return

    caldav = app_cancel_flow.build_caldav_client(settings)
    result = app_cancel_flow.cancel_occurrence(
        store, settings, caldav, course_shortname, args.date, message=args.message or "",
    )
    print(f"canceled {len(result.canceled)} registration(s) for {course_shortname} on {args.date}:")
    for c in result.canceled:
        who = f"{c.user_name} <{c.user_email}>" if c.user_email else "(unknown attendee)"
        print(f"  {who}: {c.status_before} -> canceled_by_host")


def cmd_cancel(args) -> None:
    """`my-bt cancel <query>` -- CLI equivalent of the web admin's
    /admin/cancel/<reg_id> (host-initiated cancel): same identification
    (registration_id, the natural unique key -- mirrors how admin_cancel()
    in app/webapp.py finds the registration it's canceling), same status
    transition (-> canceled_by_host), same optional message stored in
    host_message, and the SAME cancellation emails to both the participant
    and admin_email -- see app.cli_cancel.cancel_registration, which calls
    the exact app.cancellation.send_cancellation_emails function
    admin_cancel() itself calls, so this can never send something
    different from what the web admin path sends.

    Also promotes the next waitlisted person (if this cancellation freed a
    confirmed spot) and re-syncs the calendar event, via
    app.cancel_flow.cancel_and_promote -- the exact same shared logic
    admin_cancel() uses (2026-07-06: this used to be a smaller subset with
    no promotion/calendar sync; that gap is closed now). This means this
    command has a real network/CalDAV dependency and can fail/take longer
    if the CalDAV server is unreachable, unlike `my-bt erase`'s status
    check-style commands.

    2026-07-13, the operator: "would it be possible that my-bt lists a short-id
    that can also be used with my-bt cancel to cancel a booking? a bit
    like what git does with its commit ids" -- --id now accepts EITHER the
    full id OR one of `my-bt list`'s own short "id" column values (see
    app.cli_list.assign_short_ids/resolve_short_id): tried as a full id
    first (the exact same store.find_by_id() lookup as before, so nothing
    changes for any existing script passing a full id), and only resolved
    as a short-id prefix against the LIVE registration set if that exact
    lookup comes back empty.

    2026-07-13, the operator: "cancel entire course" -- `--date YYYY-MM-DD`
    (mutually exclusive with --id) cancels EVERY live confirmed/
    waitlisted/pending-confirmation registration for one occurrence at
    once, via app.cancel_flow.cancel_occurrence -- the same function
    behind the web admin's /admin checkbox and the no-login
    `/host-cancel-occurrence/<course>/<date>` magic link, so all three
    paths share one implementation. --course is optional ("as usually a
    single date for me holds a single course"): auto-detected from that
    date's live cancelable registrations if omitted, erroring with the
    list of candidates if more than one course actually has a booking on
    that date.

    2026-07-09, the operator: "make cancel also SMART like show" -- a bare
    positional `query` (mutually exclusive with --id/--date, same shape as
    `show`'s own query/--course/--user group) is auto-classified via
    app.cli_cancel.classify_cancel_query: a registration id (short or
    full) or a YYYY-MM-DD date get treated exactly as if --id/--date had
    been passed directly; a bare course shortname (not itself cancelable
    without a date) gets a helpful explanation instead of a confusing
    failure. --id/--date/--course still FORCE a specific type directly,
    bypassing auto-detection entirely, same as show's --course/--user."""
    settings = app_config.load_settings(args.settings)
    store = _store(args)

    if args.query:
        live_ids = [r["registration_id"] for r in store.read_registrations(scope="live")]
        kind, data = app_cli_cancel.classify_cancel_query(
            args.query, live_ids, settings.courses, min_id_length=app_cli_list.SHORT_ID_LENGTH,
        )
        if kind == "id":
            args.id = data
        elif kind == "ambiguous_id":
            print(f"ambiguous id {args.query!r} -- matches {len(data)} live registrations:")
            for c in data:
                print(f"  {c}")
            print("use a longer prefix, or the full registration id (see `my-bt list` for both).")
            return
        elif kind == "date":
            args.date = data
        elif kind == "course":
            print(
                f"{args.query!r} is a course, not a specific booking or date -- pair it with "
                f"--date to cancel every registration for one occurrence (e.g. `my-bt cancel "
                f"--date YYYY-MM-DD --course {data.shortname}`), or pass a registration id/date directly.",
                file=sys.stderr,
            )
            sys.exit(1)
        else:
            print(f"{args.query!r} not recognized as a registration id or date -- see `my-bt cancel -h`.", file=sys.stderr)
            sys.exit(1)

    if args.date:
        _cmd_cancel_occurrence(args, settings, store)
        return

    reg_id = args.id
    reg = store.find_by_id(reg_id)
    if reg is None:
        live_ids = [r["registration_id"] for r in store.read_registrations(scope="live")]
        resolved, candidates = app_cli_list.resolve_short_id(reg_id, live_ids)
        if resolved:
            reg_id = resolved
            reg = store.find_by_id(reg_id)
        elif candidates:
            print(f"ambiguous id {args.id!r} -- matches {len(candidates)} live registrations:")
            for c in candidates:
                print(f"  {c}")
            print("use a longer prefix, or the full registration id (see `my-bt list` for both).")
            return
    if reg is None:
        print(f"no registration with id {args.id}")
        return
    # 2026-07-13: pending_confirmation (an attendee who hasn't yet clicked their
    # account-confirmation email link) is cancelable too now -- see
    # Store.cancel()'s own docstring on why this used to be a real gap.
    if reg.status not in ("confirmed", "waitlisted", "pending_confirmation"):
        print(f"registration {reg_id} is not cancelable (status is already {reg.status!r})")
        return

    if not args.yes:
        # 2026-07-09, the operator: "Please present the booking in the form like
        # show (for the fields you line up here in 1 line). and then ask
        # below that: Cancel ? - Type 'yes' to confirm:" -- same vertical
        # key : value layout _print_single_row_kv gives `show`'s own
        # single-entity results, for the same reason: illegible crammed
        # into one line, easy to read stacked. Just the fields that were
        # already in that one line (not the full raw row show's own
        # registration view prints -- token hashes/party ids aren't
        # useful in a quick confirmation prompt).
        user = store.find_user_by_id(reg.user_id)
        who = f"{user.name} <{user.email}>" if user else "(unknown attendee)"
        _print_single_row_kv(
            {
                "attendee": who,
                "course": reg.course_shortname,
                "date": reg.occurrence_date,
                "registration": reg_id,
            },
            "table",
        )
        confirm = input("Cancel? Type 'yes' to confirm: ")
        if confirm.strip().lower() != "yes":
            print("aborted")
            return

    result = app_cli_cancel.cancel_registration(store, settings, reg_id, message=args.message or "")
    if not result.ok:
        print(f"could not cancel {reg_id}: {result.reason}")
        return

    who = f"{result.user_name} <{result.user_email}>" if result.user_email else "(unknown attendee)"
    print(f"canceled registration {result.registration_id}:")
    print(f"  attendee: {who}")
    print(f"  course:   {result.course_shortname} on {result.occurrence_date}")
    print(f"  status:   {result.status_before} -> canceled_by_host")
    if result.message:
        print(f"  message: {result.message}")
    print(f"  notified: {'yes (both participant and admin emailed)' if result.emailed else 'no (course no longer configured in settings.toml)'}")


def cmd_admin_gdpr(args) -> None:
    """`my-bt admin gdpr` -- GDPR overview: the configured retention
    window(s), then how many bookings/accounts currently sit past them.
    Read-only, touches nothing. See `admin gdpr erase` for manual Art. 17
    erasure, and `admin gdpr bookings` / `admin gdpr accounts` for the
    per-row listing (each with its own --purge to act).

    2026-07-14, the operator, restructuring the former top-level `gdpr-retention`
    (renamed 2026-07-13 from `purge-retention`) into this shape: "add:
    my-bt admin gdpr this by default tells you the set retention period on
    top and then gives you status on accounts and bookings (OVERVIEW /
    stats)." Moved under `admin` (site-administration) rather than staying
    top-level, since it now covers accounts too, not just bookings.
    `erase` (formerly its own top-level-under-admin command) joined this
    group the same day, same reasoning: "lets move this to my-admin gdpr
    please" -- it's GDPR machinery too, no reason for it to sit apart
    from `bookings`/`accounts`."""
    settings = app_config.load_settings(args.settings)
    store = _store(args)
    today = date.today()
    print(
        f"registration retention: {settings.retention_months} months after occurrence "
        f"({settings.canceled_retention_months} months after cancellation; "
        f"{settings.pending_confirmation_hours}h for an unconfirmed signup)"
    )
    print(f"account retention: {settings.retention_months} months of inactivity (last login, or account creation if never logged back in)")
    bookings_due = sum(1 for r in store.all_registrations() if app_retention.should_purge(r, today, settings))
    print(f"{bookings_due} booking row(s) past their retention window (see `admin gdpr bookings`)")
    accounts_due = sum(
        1 for row in store.read_users(scope="live")
        if (d := app_retention.account_deletion_date(User(**row), settings)) is not None and d <= today
    )
    print(f"{accounts_due} account(s) past their retention window (see `admin gdpr accounts`)")

    # 2026-07-14, the operator: "please also provide a table with the currently
    # expected purge counts per month for accounts and for bookings" --
    # one combined table, merging both dicts' month keys (plain "YYYY-MM"
    # strings sort correctly lexicographically, no date parsing needed).
    # Includes past-due months too (matches bookings_due/accounts_due
    # above counting past-due rows as well), not just upcoming ones.
    booking_counts = app_retention.registration_purge_counts_by_month(store, settings)
    account_counts = app_retention.account_deletion_counts_by_month(store, settings)
    months = sorted(set(booking_counts) | set(account_counts))
    if months:
        print("\nexpected purge counts by month:")
        _print_rows(
            [
                {"month": m, "bookings": booking_counts.get(m, 0), "accounts": account_counts.get(m, 0)}
                for m in months
            ],
            "table",
        )


def cmd_admin_gdpr_bookings(args) -> None:
    """`my-bt admin gdpr bookings` -- lists every registration and the
    date it would be (or already was) purged under the GDPR
    storage-limitation policy (app/retention.py's own docstring has the
    three separate clocks: 24mo after occurrence, 6mo after cancellation,
    48h for an abandoned pending-confirmation signup). Add --purge to
    actually delete rows past their window now -- the same job the
    nightly systemd timer runs (systemd/my-booking-retention.timer), just
    on demand. Read-only without --purge."""
    settings = app_config.load_settings(args.settings)
    store = _store(args)
    if args.purge:
        purged = app_retention.run_purge(store, settings)
        print(f"purged {purged} row(s)")
        return
    today = date.today()
    rows = [
        {
            "registration_id": r.registration_id, "course": r.course_shortname,
            "date": r.occurrence_date, "status": r.status,
            "purge_date": app_retention.registration_purge_date(r, settings).isoformat(),
            "past_due": "yes" if app_retention.should_purge(r, today, settings) else "no",
        }
        for r in store.all_registrations()
    ]
    _print_rows(rows, args.format)


def cmd_admin_gdpr_accounts(args) -> None:
    """`my-bt admin gdpr accounts` -- lists every live account and the
    date it reaches `retention_months` of inactivity. Add --purge to
    actually act now: sends any due deletion-warning emails (see
    app.retention.send_account_deletion_warnings -- a courtesy notice,
    only if [privacy].how_many_days_before_account_deletion_send_warning_mail
    is configured) AND erases every account already past its deadline
    (app.retention.purge_dormant_accounts -- always runs, regardless of
    whether the warning is enabled; 2026-07-14, the operator: "yes regardless"
    and "tied to retention_months exactly, this is the GDPR law").
    Read-only without --purge."""
    settings = app_config.load_settings(args.settings)
    store = _store(args)
    if args.purge:
        warned = app_retention.send_account_deletion_warnings(store, settings)
        caldav = app_cancel_flow.build_caldav_client(settings)
        erased = app_retention.purge_dormant_accounts(store, settings, caldav=caldav)
        print(f"{warned} warning email(s) sent, {erased} dormant account(s) erased")
        return
    today = date.today()
    rows = [
        {
            "user_id": row["user_id"], "email": row["email"], "name": row["name"],
            "last_login_at": row["last_login_at"] or "(never)",
            "deletion_date": d.isoformat() if (d := app_retention.account_deletion_date(User(**row), settings)) else "(no activity signal)",
            "past_due": "yes" if d is not None and d <= today else "no",
        }
        for row in store.read_users(scope="live")
    ]
    _print_rows(rows, args.format)


def cmd_admin_logout(args) -> None:
    """`my-bt admin logout EMAIL` / `my-bt admin logout --all` -- force-
    clears active session(s) on the LIVE running process (see
    app/webapp.py::internal_logout), the same in-memory SESSIONS dict
    `my-bt status`'s "active sessions" line already reads. 2026-07-10,
    the operator: added specifically so `setup -i`'s "Restart my-booking.service
    now?" step (and the RPM's own %pre gate before an upgrade) have
    something concrete to point at instead of just refusing and leaving
    you stuck -- clear sessions on purpose here, then retry."""
    if args.all and args.email_pos:
        print("error: pass either an email or --all, not both", file=sys.stderr)
        sys.exit(1)
    if not args.all and not args.email_pos:
        print("error: `my-bt admin logout EMAIL` or `my-bt admin logout --all`", file=sys.stderr)
        sys.exit(1)
    params = {"all": "1"} if args.all else {"email": args.email_pos}
    payload, error = _post_internal_logout(args.internal_url, **params)
    if error:
        print(f"logout failed: {error}", file=sys.stderr)
        sys.exit(1)
    n = payload.get("logged_out", 0)
    if args.all:
        print(f"logged out {n} active session(s) (everyone).")
    elif n:
        print(f"logged out {n} active session(s) for {args.email_pos}.")
    else:
        print(f"no active session for {args.email_pos}.")


def cmd_git_snapshot(args) -> None:
    """`my-bt git-snapshot` -- manually run the same hourly auto-commit
    the systemd timer runs (see systemd/my-booking-git-snapshot.timer):
    stages and commits any change under --data-dir's own, separate git
    repo, or reports if there's nothing to commit / it isn't a git repo
    yet (run `my-bt setup -i` to initialize one)."""
    data_dir = Path(args.data_dir)
    if args.dry_run:
        if not (data_dir / ".git").exists():
            print(f"{data_dir} is not yet a git repo -- run `my-bt setup -i` to initialize it")
            return
        import subprocess

        result = subprocess.run(
            ["git", "status", "--porcelain"], cwd=str(data_dir), capture_output=True, text=True
        )
        changed = [ln for ln in result.stdout.splitlines() if ln.strip()]
        if changed:
            print(f"would commit {len(changed)} changed file(s) (dry run, nothing changed):")
            for ln in changed:
                print(f"  {ln}")
        else:
            print("nothing changed (dry run, nothing to commit)")
        return

    result = app_git_snapshot.snapshot(data_dir, message=args.message)
    print(result.detail)


def cmd_maintenance(args) -> None:
    """`my-bt admin site-maintenance on|off|status [-m/--message TEXT]` --
    sitewide maintenance toggle (2026-07-10, the operator: "add my-bt commands to
    set / unset a maintenance mode"; renamed from `admin maintenance`
    2026-07-14, the operator: "rename my-bt admin site-maintenance to my-bt admin
    site-maintenance" -- disambiguates from any future per-course/per-
    feature "maintenance" concept). The actual state/rendering logic
    lives in app/maintenance.py (see its own module docstring for the
    full design -- a data-dir JSON flag file, not settings.toml, so it
    takes effect on the very next request with no service restart).

    `on` (optionally with -m/--message for something specific like
    "back Monday") does two things: writes the flag file the running app
    checks on every guarded request (see app/maintenance.py's own
    docstring for exactly which routes that covers), AND directly patches
    an idempotent, clearly-marked banner into the TOP of the live,
    deployed index.html at [site].static_site_dir, if configured.

    2026-07-10, the operator: "the my-bt should not modify the package installed
    TEMPLATE folder site" -- this used to ALSO patch this checkout's own
    HOME/site/index.html (the package's install location), but that copy
    is a template/reference only (never what nginx actually serves, see
    README.md "Static-site pages" and "Generic template vs. your real
    config") -- [site].static_site_dir is the one real, live location, same
    as privacy.html/terms.html already treat it, so that's the only file
    this ever writes to now. If static_site_dir isn't configured, `on`/
    `off` still flip the flag file (the app-side gating still works) but
    print a note that no banner was written anywhere.

    `off` reverses both. `status` only reports the current state --
    touches nothing."""
    from app import maintenance as app_maintenance

    raw = app_config.load_raw_toml(args.settings)
    admin_email = (raw or {}).get("site", {}).get("admin_email", "")
    static_site_dir = (raw or {}).get("site", {}).get("static_site_dir")

    if args.maintenance_command == "status":
        state = app_maintenance.read_state(args.data_dir)
        if state.enabled:
            print(f"maintenance mode: ON (since {state.set_at})")
            if state.message:
                print(f"  message: {state.message}")
        else:
            print("maintenance mode: off")
        return

    targets = [Path(static_site_dir) / "index.html"] if static_site_dir else []

    enabling = args.maintenance_command == "on"
    if enabling:
        state = app_maintenance.enable(args.data_dir, message=args.message or "")
        message = state.message
    else:
        app_maintenance.disable(args.data_dir)
        message = ""

    if not targets:
        print("[site].static_site_dir not configured -- no live index.html to add/remove the banner from.")
    for t in targets:
        if app_maintenance.apply_banner_to_file(t, enabling, admin_email, message):
            action = "added to" if enabling else "removed from"
            print(f"[ok] banner {action} {t}")
        elif t.exists():
            print(f"[ok] {t} already up to date")
        else:
            print(f"[skip] {t} does not exist")

    if enabling:
        print("maintenance mode: ON -- attendee-facing pages now show a maintenance page. "
              "Run `my-bt admin site-maintenance off` to reopen the site.")
    else:
        print("maintenance mode: off -- the site is open again.")


def _query_internal_status(base_url: str, timeout: float = 3.0) -> tuple[dict | None, str | None]:
    """GETs {base_url}/internal/status (see app/webapp.py::internal_status)
    directly -- same host, loopback only, bypassing nginx entirely.
    Returns (payload, error): exactly one of the two is set, never both,
    so callers don't have to guess which to trust. A connection failure
    here (refused/timed out) is itself the single most useful "is the
    server up and running" signal `my-bt status` can give -- every other
    check in this file inspects config/secrets/systemd-unit-state, but
    none of them actually confirm the WSGI process is alive and answering
    requests the way this one does."""
    url = base_url.rstrip("/") + "/internal/status"
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:  # noqa: S310 - fixed http://127.0.0.1 URL
            return json.loads(resp.read().decode("utf-8")), None
    except urllib.error.HTTPError as exc:
        return None, f"HTTP {exc.code} from {url}"
    except (urllib.error.URLError, OSError, ValueError) as exc:
        return None, f"{exc} -- is the my-booking service running (`systemctl status my-booking`)?"


def _post_internal_logout(base_url: str, timeout: float = 5.0, **params: str) -> tuple[dict | None, str | None]:
    """POSTs {base_url}/internal/logout (see app/webapp.py::internal_logout)
    -- `my-bt admin logout`'s actual mechanism. Same (payload, error)
    contract and same direct-loopback-bypassing-nginx reasoning as
    _query_internal_status above."""
    url = base_url.rstrip("/") + "/internal/logout"
    data = urllib.parse.urlencode(params).encode("utf-8")
    try:
        with urllib.request.urlopen(url, data=data, timeout=timeout) as resp:  # noqa: S310 - fixed http://127.0.0.1 URL
            return json.loads(resp.read().decode("utf-8")), None
    except urllib.error.HTTPError as exc:
        return None, f"HTTP {exc.code} from {url}"
    except (urllib.error.URLError, OSError, ValueError) as exc:
        return None, f"{exc} -- is the my-booking service running (`systemctl status my-booking`)?"


def _fmt_ts(iso: str | None) -> str:
    if not iso:
        return "(none yet)"
    try:
        return datetime.fromisoformat(iso).strftime("%Y-%m-%d %H:%M UTC")
    except ValueError:
        return iso


def _print_live_status(payload: dict) -> None:
    """The concise, default `my-bt status` output the operator asked for
    (2026-07-13): server-up summary, maintenance mode (highlighted if
    ON), and the live logged-in-user list -- everything the full
    per-check report (-V/--verbose, see cmd_status) would otherwise bury
    a long scroll below.

    2026-07-10, the operator: "redesign the output ... to follow the pattern:
    field   value and align the values" plus "add the # of active
    sessions" -- prompted by asking whether an RPM upgrade could refuse
    to proceed while someone's logged in. Turned out unnecessary for
    that (SESSIONS is in-memory -- ANY service restart already clears it,
    RPM upgrade or not, and nothing is lost besides having to log back
    in), but the visibility itself is still worth having at a glance.
    Reuses _print_single_row_kv -- the same aligned "key : value" layout
    `my-bt show`'s single-entity views already use -- rather than a
    second, separately-drifting implementation of the same idea."""
    mnt = payload.get("maintenance", {})
    sessions = payload.get("sessions", [])
    _print_single_row_kv(
        {
            "version": payload.get("version", "?"),
            "server time": _fmt_ts(payload.get("server_time")),
            "maintenance mode": "ON" if mnt.get("enabled") else "off",
            "active sessions": len(sessions),
        },
        "table",
    )

    if mnt.get("enabled"):
        banner = "!!  MAINTENANCE MODE IS ON -- attendees are seeing a maintenance page  !!"
        print()
        print("!" * len(banner))
        print(banner)
        print("!" * len(banner))
        since = _fmt_ts(mnt.get("set_at")) if mnt.get("set_at") else "(unknown time)"
        print(f"since {since}" + (f': "{mnt["message"]}"' if mnt.get("message") else ""))
        print("Run `my-bt admin site-maintenance off` to reopen the site.")

    if not sessions:
        return
    print()
    print("logged-in users:")
    rows = [
        {
            "who": s["who"] + (" [admin]" if s["kind"] == "admin" else ""),
            "connected since": _fmt_ts(s.get("connected_since")),
            "last page": s.get("last_page") or "(none yet)",
            "last seen": _fmt_ts(s.get("last_seen")),
        }
        for s in sessions
    ]
    _print_rows(rows, "table")


# -- status / setup --------------------------------------------------------------
# The actual check/report/interactive-walkthrough logic lives in
# app/cli_checks.py + app/cli_setup.py -- deliberately NOT here, so it's
# importable and unit-tested by tests/ (this script has no .py extension
# and lives outside app/, so unittest can't reach it directly). Add a new
# check there, once, rather than growing this file -- separate copies of
# this kind of thing have drifted and caused real bugs in this project
# before (see git history for how that used to go wrong).

def cmd_status(args) -> None:
    """`my-bt status` -- quick, live-only summary: whether the process is
    actually up and answering requests right now (queried directly over
    HTTP on its own loopback port -- see _query_internal_status), whether
    maintenance mode is on (highlighted if so), and who's currently
    logged in (any unexpired session -- 2026-07-13, the operator: "logged in
    means: unexpired sessions" -- with since-when-connected and their
    current/last-loaded page+timestamp, read straight out of the live
    process's own in-memory SESSIONS dict, see
    app/webapp.py::internal_status).

    2026-07-13, the operator: originally this command also had a -V/--verbose
    flag that additionally printed a long settings/secrets/systemd/
    SELinux/nginx install-health report -- moved out into its own command,
    `my-bt admin health`, instead ("status as discussed (but the -V is now:
    admin health)"). Keeps `status` fast and purely about "is it alive
    right now"; `admin health` is for actually diagnosing an install
    problem."""
    payload, error = _query_internal_status(args.internal_url)
    if error:
        print(f"live process: NOT RESPONDING -- {error}")
        sys.exit(1)
    _print_live_status(payload)


def cmd_admin_watchdog_check(args) -> None:
    """`my-bt admin watchdog-check` -- runs the exact same "strange usage
    patterns" sweep the systemd timer runs (systemd/my-booking-watchdog.timer,
    every [watchdog].window_minutes) right now, on demand: nginx access-log
    bursts, app-log rate-limiter rejections, a pending-signup burst, and
    sshd failed-password bursts (see app/watchdog.py's own module
    docstring for all four). Emails settings.admin_email ONE combined
    alert if anything fired, same as the timer -- this is not a dry run.

    2026-07-14, the operator: "Same for any other script we have lets integrate
    this into the admin as subcommand(s) please" -- watchdog had no CLI
    equivalent before this; see systemd/my-booking-watchdog.service for
    the timer now calling this instead of `python3 -m app.watchdog`
    directly."""
    settings = app_config.load_settings(args.settings)
    store = _store(args)
    alerts = app_watchdog.check_now(store, settings)
    if alerts:
        print(f"{len(alerts)} alert(s) fired (emailed to {settings.admin_email}):")
        for a in alerts:
            print(f"- {a}")
    else:
        print("nothing unusual found")


def cmd_admin_health(args) -> None:
    """`my-bt admin health` -- full install-health diagnostic: settings.toml
    (plus any pending settings.toml.rpmnew / privacy.html.tmpl.rpmnew merge
    and a package-wide `rpm -V` integrity check), secrets (existence,
    permissions, and -- for admin_password_hash / erasure_pepper --
    whether the content looks right), the data dir (writable, git-snapshot
    protected, AND -- 2026-07-08, real incident: see
    cli_checks.check_data_dir_ownership's own docstring -- every *.csv in
    it actually OWNED by the my-booking service user, checked via
    os.stat() rather than os.access() specifically so running this itself
    as root, a completely normal thing to do here, can't mask a real
    ownership problem), the configured log file (if any), my-booking
    group membership, systemd units, whether settings.toml has been
    edited since the service last (re)started (it's only read once at
    startup -- an edit made after that isn't live yet, even though the
    file itself is already correct), SELinux, whether every nginx
    `location` block this app needs is present in the live config, and
    (if [site].static_site_dir is configured) whether the live deployed
    privacy.html still matches this settings.toml, plus whether any of
    the live site/*.html pages still contain a leftover REPLACE-ME or
    unsubstituted ${...} placeholder. Deliberately no network/CalDAV
    check here, same reasoning as `erase` -- this CLI has no CalDAV
    dependency by design, so it still works to diagnose things even if
    the CalDAV/SMTP provider itself is unreachable.

    2026-07-13: this is what plain `my-bt status` used to print (first
    unconditionally, then behind -V/--verbose) -- split out into its own
    command so `status` stays a fast "is it alive" check and this stays
    the slower, deeper "what's wrong with the install" one. See `my-bt
    status` for the live-process/session-list summary instead."""
    from app import cli_checks, cli_setup

    checks: list[cli_checks.Check] = []

    # -- settings.toml -------------------------------------------------------
    raw = None
    try:
        raw = app_config.load_raw_toml(args.settings)
    except Exception as exc:  # noqa: BLE001 - report, don't abort the rest
        checks.append((f"settings.toml ({args.settings})", "fail", f"failed to parse: {exc}"))
    if raw is None and not checks:
        checks.append((f"settings.toml ({args.settings})", "fail", "file does not exist"))
    elif raw is not None:
        checks.append((f"settings.toml ({args.settings})", "ok", "parses OK"))
        courses = raw.get("course", [])
        if courses:
            checks.append((f"{len(courses)} course(s) configured", "ok",
                            ", ".join(c.get("shortname", "?") for c in courses)))
        else:
            checks.append(("courses configured", "warn", "no [[course]] blocks found"))
        tmpl = cli_setup.tmpl_path(HOME)
        checks.extend(cli_checks.check_rpmnew([args.settings, str(tmpl)]))
        checks.extend(cli_checks.check_static_site_drift(raw, tmpl))
        checks.extend(cli_checks.check_static_site_compliance(raw))

    # -- secrets --------------------------------------------------------------
    if raw:
        checks.extend(cli_checks.check_secrets(raw))

    # -- data dir ---------------------------------------------------------------
    data_dir = Path(args.data_dir)
    if not data_dir.exists():
        checks.append((f"data dir ({data_dir})", "warn", "does not exist yet -- created on first booking/run"))
    elif not os.access(data_dir, os.W_OK):
        checks.append((f"data dir ({data_dir})", "fail", "not writable by the current user"))
    else:
        checks.append((f"data dir ({data_dir})", "ok", "exists and writable"))
    checks.extend(cli_checks.check_data_dir_git(data_dir))
    checks.extend(cli_checks.check_data_dir_ownership(data_dir))
    checks.extend(cli_checks.check_directory_fsync_support(data_dir))

    # -- configured log file, if any ---------------------------------------------
    log_file = app_config.peek_log_file(args.settings) if raw else None
    if log_file:
        lp = Path(log_file)
        if lp.exists() and not os.access(lp, os.W_OK):
            checks.append((f"log file ({log_file})", "fail", "exists but not writable by the current user"))
        elif not lp.exists() and not os.access(lp.parent, os.W_OK):
            checks.append((f"log file ({log_file})", "warn",
                "doesn't exist yet and its directory isn't writable by you -- "
                "start the service once (it creates it), or create it yourself"))
        else:
            checks.append((f"log file ({log_file})", "ok", "configured and writable"))

    # -- my-booking group membership, systemd, SELinux, package integrity -------
    checks.extend(cli_checks.check_group_membership())
    checks.extend(cli_checks.check_systemd())
    checks.extend(cli_checks.check_settings_fresh(args.settings))
    checks.extend(cli_checks.check_selinux())
    checks.extend(cli_checks.check_rpm_verify())

    # -- nginx location blocks ---------------------------------------------------
    # 2026-07-06 fix: `setup -i` already ran this (via cli_setup.build_report)
    # and would have caught a missing block (e.g. a brand-new route like
    # /courses added to the app but never proxied on a real vhost) -- but
    # plain `status` never called it at all, so it could print "all checks
    # passed" while a route was silently unreachable through nginx. Local
    # `nginx -T`, no network dependency, so this fits the same "deliberately
    # no network/CalDAV check" carve-out in this method's own docstring just
    # fine -- that carve-out was about CalDAV/SMTP reachability, not this.
    checks.extend(cli_checks.check_nginx_locations())

    # -- real, personal nginx vhost conf file kept in this checkout's site/
    # dir (e.g. site/booking.example.org.conf), if any -- catches the SAME kind of
    # location-block gap as check_nginx_locations() above, but at the
    # source, in the checkout itself, before it's ever deployed/reloaded.
    checks.extend(cli_checks.check_nginx_conf_repo_file(HOME))

    # -- real, DEPLOYED nginx vhost conf at [site].nginx_conf_path, if
    # configured -- read directly off disk, not via `nginx -T`, so this
    # works even without the nginx binary reachable. Unlike the checkout
    # check above, a problem found here is reported as "fail": setting
    # this path is a deliberate statement that this exact file is real
    # and matters (2026-07-10, the operator: "truly ERROR out in case there is
    # a problem").
    if raw:
        checks.extend(cli_checks.check_nginx_conf_deployed(raw))

    # -- calendar invite format ----------------------------------------------------
    # 2026-07-15, the operator (real production `setup -i` run): the marker-file
    # check was printed as a raw "[warn] ..." line inside interactive_setup()
    # only, never a structured Check -- so it didn't count towards fails/
    # warns, wasn't repeated in the "Still need attention" summary, and
    # `setup -i` still exited "Done -- all checks pass now." right below its
    # own contradictory warning. Marker-file read only, no network call, so
    # unlike check_nginx_conf_deployed just above this isn't gated any
    # tighter than `if raw:` -- check_calendar_invite_format() itself
    # returns [] (shown as SKIP by print_report()) when CalDAV isn't fully
    # configured yet.
    if raw:
        checks.extend(cli_checks.check_calendar_invite_format(raw, data_dir))

    # 2026-07-15/16, the operator, from a real production run: 3 occurrences hit
    # persistent CalDAV conflicts during a resync, got skipped, and NEITHER
    # of the checks above caught it -- check_calendar_invite_format() only
    # asks "did an attempt happen for the current format version", never
    # "did every occurrence in that attempt actually succeed". Marker-file
    # read only (no network call), same as check_calendar_invite_format
    # just above -- always safe to run, not gated behind `if raw:` either,
    # though in practice the marker only ever exists after a real resync
    # attempt ran.
    checks.extend(cli_checks.check_calendar_invite_resync_skips(data_dir))

    # -- maintenance mode ---------------------------------------------------------
    # 2026-07-11, the operator: "maintenance happens enough often that it is
    # annoying to have to check what this warning was about.. so please do
    # this at the end as last check so that it's easily visible." Used to
    # sit right after the data-dir/git-snapshot check, near the top of a
    # long list -- easy to miss in a scroll-back, and the operator toggles
    # maintenance mode often enough that this specific WARN was the one he
    # kept having to hunt for. Deliberately last of every check group here
    # (both `print_report()`/plain `setup` and `interactive_setup()`/
    # `setup -i` already did this -- see their own "12. Maintenance mode"
    # steps -- only plain `status` hadn't caught up).
    checks.extend(cli_checks.check_maintenance_mode(data_dir))

    fails = sum(1 for _, level, _ in checks if level == "fail")
    warns = sum(1 for _, level, _ in checks if level == "warn")

    icon = {"ok": "OK  ", "warn": "WARN", "fail": "FAIL"}
    for label, level, detail in checks:
        line = f"[{icon[level]}] {label}"
        if detail:
            line += f" -- {detail}"
        print(line)

    # 2026-07-08, the operator: "please repeat all warnings at the end of setup
    # and status explicitly" -- by the bottom of a long report the actual
    # WARN/FAIL lines are long since scrolled past; repeat just those,
    # together, right before the final pass/fail summary below.
    problems = cli_checks.summarize_problems(checks)
    if problems:
        print("\nWarnings/failures, repeated from above:")
        for line in problems:
            print(f"   {line}")

    print()
    if fails:
        print(f"{fails} problem(s), {warns} warning(s) -- fix the FAIL item(s) above, "
              "then re-run `my-bt admin health`.")
        sys.exit(1)
    elif warns:
        # 2026-07-10, the operator: "please make my-bt status FAIL in case of any
        # warning so that this is more visible. because a missing location
        # is a real (potential) problem." -- a WARN used to be purely
        # cosmetic (exit 0), which let a real, actionable gap (e.g. a
        # missing nginx `location` block, silently making a whole route
        # unreachable through nginx) sail straight past `my-bt admin health &&
        # <next step>` in a script/cron/CI context. Any warning now exits
        # non-zero too, same as a FAIL -- only a fully clean report exits 0.
        print(f"{warns} warning(s), no hard failures -- worth a look above.")
        sys.exit(1)
    else:
        print("all checks passed.")


def cmd_setup(args) -> None:
    """`my-bt setup` -- shows the guided post-install steps (secrets,
    pending .rpmnew merges, settings review, nginx, group membership,
    systemd, SELinux, static site), computed fresh from the current
    install state each time -- the single source of truth for this,
    instead of the RPM %post / scripts/install.sh each keeping their own
    separate copy of the text (which drifted before and caused real bugs).
    Already-satisfied steps are shown as done, not
    just always the full static list. Pass --interactive/-i to be walked
    through them one at a time and have my-bt perform what it safely can
    (most of it needs root, including regenerating the live static
    privacy page if [site].static_site_dir is configured). Both plain and
    `-i` exit non-zero if any check comes back WARN or FAIL (reflecting
    the CURRENT state after whatever `-i` just fixed, not the state it
    started at) -- same policy as `status` (2026-07-10, the operator: wants
    `setup` scriptable/cron-checkable the same way `status` already is;
    caught in practice the same day: `my-bt setup -i && my-bt status` ran
    `status` unconditionally, because only the plain branch exited
    non-zero at first) -- so `my-bt setup [-i] && <next step>` is a safe
    gate either way, not just a human-readable report."""
    from app import cli_setup

    raw = app_config.load_raw_toml(args.settings)
    if raw is None:
        print(f"error: {args.settings} not found -- install the package first", file=sys.stderr)
        sys.exit(1)
    if args.interactive:
        fails, warns = cli_setup.interactive_setup(raw, args.settings, HOME, data_dir=args.data_dir)
    else:
        fails, warns = cli_setup.print_report(raw, args.settings, HOME, data_dir=args.data_dir)
    if fails or warns:
        sys.exit(1)


class _HelpfulArgumentParser(argparse.ArgumentParser):
    """2026-07-13, the operator: "please always show the -h version instead a
    shortened usage version only, e.g. when calling 'my-bt' or 'my-bt
    history'" -- argparse's default error() (hit on a missing required
    subcommand, e.g. bare `my-bt`, or a missing required argument, e.g.
    `my-bt history` with no --email) prints only the one-line usage
    summary before the error, not the full option list/help text -- easy
    to hit by accident and not very actionable on its own. Prints the
    SAME output -h/--help would instead. add_subparsers() defaults
    `parser_class` to `type(self)` (see argparse's own source), so every
    subparser built off this one -- `my-bt history`, `my-bt cancel`, etc.
    -- inherits this too, covering both cases the operator named with the one
    override."""
    def error(self, message):
        self.print_help(sys.stderr)
        self.exit(2, f"\n{self.prog}: error: {message}\n")


def _add_subcommand(subparsers, name: str, summary: str, extra: str = "", **kwargs):
    """Registers one subcommand with a `-h` page that opens with AT LEAST
    the same one-sentence summary shown in its parent's own listing, plus
    (where there's something worth adding) one more sentence of detail.

    2026-07-08, the operator, on `my-bt admin -h` printing a bare usage+options
    dump with no explanation of what "admin" even is: "There should be a
    sentence here about the admin command as such" -- then, generalizing
    it to every subcommand: "you need to have AT LEAST what my-bt -h
    gives you about the command but maybe even 1 sentence more or so."
    argparse only ever shows `description=` when a leaf parser's own
    `-h`/`--help` is invoked directly -- `help=` alone (what every
    add_parser() call here used before this existed) only surfaces in
    the PARENT's own subcommand listing, never on the child's own page.
    Without this, `my-bt <command> -h` was just usage + the option list,
    with zero explanation of what the command actually does."""
    description = f"{summary} {extra}".strip() if extra else summary
    return subparsers.add_parser(name, help=summary, description=description, **kwargs)


# -- zsh completion -----------------------------------------------------
# 2026-07-08, the operator: "can you please built into the script a zsh
# compatible shell auto-complete that is auto-installing in the users
# home dir on first run" -- then, once reminded this had never actually
# been built and asked to do it: "as we have the package you are right
# though that we can do this via the rpm!" -- so instead of my-bt writing
# to the user's own $HOME/.zshrc at runtime (fragile: fighting over one
# shared dotfile, needing to detect whether it's already been added,
# surviving the user's own edits...), packaging/my-booking-tool.spec's
# %build generates a static completion file from THIS EXACT build's own
# `build_parser()` (see below) and %install ships it straight into the
# system-wide zsh completion directory (%{_datadir}/zsh/site-functions),
# already on every zsh's fpath by default on Fedora -- no per-user setup
# at all, and it can never drift out of sync with the real subcommands/
# flags the way a hand-maintained completion file would, since it's
# regenerated from the real argparse tree on every single build.
def _zsh_escape(text: str) -> str:
    """Sanitizes an argparse help= string for safe embedding inside a
    single-quoted zsh _arguments/_describe '...[description]' spec:
    collapses whitespace, strips `[`/`]` (these delimit the description
    itself in _arguments' own spec syntax, so a literal one in the help
    text would prematurely end it), and escapes embedded single quotes
    the standard zsh way. `:` is deliberately left alone -- it's only a
    delimiter for the OPTIONAL trailing ':message:action' part of a spec
    (which none of these specs ever use), not inside the [description]
    bracket itself, so stripping it would just make URLs/times/ratios in
    help text (e.g. "http://...", "13/19") harder to read for no reason."""
    text = " ".join((text or "").split())
    for ch in "[]":
        text = text.replace(ch, "")
    return text.replace("'", "'\\''")


def _expand_help_text(parser: argparse.ArgumentParser, action: argparse.Action) -> str:
    """Mirrors argparse.HelpFormatter._expand_help's own %(default)s/
    %(prog)s/etc. substitution. `action.help` is the RAW, un-expanded
    format string -- argparse only interpolates it when actually
    rendering -h/--help text through a HelpFormatter, never on plain
    attribute access -- so without this, e.g. `status`'s --internal-url
    help (which uses %(default)s) would show up in the completion
    tooltip as the literal, un-substituted text "%(default)s" instead of
    the real default value."""
    help_text = action.help or ""
    if "%" not in help_text:
        return help_text
    params = dict(vars(action), prog=parser.prog)
    for k, v in list(params.items()):
        if v is argparse.SUPPRESS:
            del params[k]
    try:
        return help_text % params
    except (KeyError, ValueError, TypeError):
        return help_text


def _zsh_option_specs(parser: argparse.ArgumentParser) -> list[str]:
    """One RAW (un-indented, no line-continuation) zsh _arguments spec
    string per --option/-o this parser itself defines (NOT its own
    subcommands' options) -- -h/--help excluded, zsh's own completion
    system already handles that everywhere. See _zsh_join for how these
    get assembled into an actual multi-line _arguments invocation.

    2026-07-09, the operator: "as much autocomplete as possible also if it
    recognises a course-name maybe if this is possible?" -- every
    `--course` option (dest == "course") gets a `:course:
    _mb_course_shortnames` value-completion suffix, so `--course <TAB>`
    offers real course shortnames parsed live from settings.toml (see
    generate_zsh_completion's own module docstring for the shell
    function itself and why it's a live parse, not a build-time-frozen
    list). Every OTHER option stays flag-only -- appending a value
    completer to a plain store_true flag would incorrectly tell zsh that
    flag takes an argument."""
    specs = []
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            continue
        opts = [s for s in action.option_strings if s not in ("-h", "--help")]
        if not opts:
            continue
        desc = _zsh_escape(_expand_help_text(parser, action))
        value = ":course:_mb_course_shortnames" if action.dest == "course" else ""
        if len(opts) > 1:
            # zsh's own idiom for "these aliases are mutually exclusive
            # with each other, both get this same description" is
            # '(-D --debug)'{-D,--debug}'[desc]' -- THREE separate shell
            # words concatenated with no whitespace between them, where
            # the MIDDLE one is a bare (unquoted) brace-expansion, not
            # text sitting inside the surrounding quotes. Brace expansion
            # only happens on UNQUOTED text -- wrapping '{-D,--debug}' in
            # the same quotes as the rest (an earlier version of this
            # function did exactly that) leaves it as inert literal
            # characters instead, which _arguments then can't parse at
            # all ("invalid argument: (-D --debug){-D,--debug}[...]" --
            # a real failure the operator hit on the actual VPS, not caught here
            # since there's no zsh in this sandbox to actually execute
            # the generated script against).
            group = f"({' '.join(opts)})"
            brace = "{" + ",".join(opts) + "}"
            specs.append(f"'{group}'{brace}'[{desc}]{value}'")
        else:
            specs.append(f"'{opts[0]}[{desc}]{value}'")
    return specs


def _zsh_positional_specs(parser: argparse.ArgumentParser) -> list[str]:
    """RAW zsh positional-argument specs (position 1, 2, ... within
    WHATEVER _arguments call these get joined into -- see
    generate_zsh_completion, this is only ever used for a LEAF command's
    own `_arguments -s`, never the top-level/admin dispatcher's own
    '1: :->state' plumbing) for this parser's own plain positional
    arguments (no option_strings) -- e.g. show's/cancel's free-form
    `query`, or `maintenance`'s on/off/status.

    `choices=[...]` positionals (maintenance_command) get an exact-value
    zsh action, e.g. '(on off status)' -- fully generic, no special-
    casing needed. Free-text ones (show's/cancel's `query`) get course-
    shortname completion via _mb_course_shortnames -- ONE of several
    things you could type there (an id/date/email won't tab-complete,
    but typing one is still perfectly valid), the one this completion
    script can cheaply offer without shelling out to my-bt itself."""
    specs = []
    position = 0
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            continue
        if action.option_strings:
            continue
        position += 1
        desc = _zsh_escape(_expand_help_text(parser, action))
        # Unlike the '...[description]' bracket syntax _zsh_option_specs
        # uses (where only [/] are meaningful), a positional's 'N:message:
        # action' spec treats EVERY colon as a field separator -- zsh's
        # own docs are explicit that a literal colon must be backslash-
        # escaped even between these fields, not just within one. Without
        # this, a colon anywhere in the real help text (e.g. show's own
        # query help starts "anything: registration id...") silently
        # shifts where the message ends and the action begins. Also
        # capped to the first clause -- these are long, full-sentence
        # argparse help strings, impractical as a one-line completion
        # menu message either way.
        message = desc.split(" -- ")[0].split(", ")[0]
        if len(message) > 40:
            message = message[:40].rstrip() + "..."
        message = message.replace(":", r"\:")
        if action.choices:
            choices_str = " ".join(str(c) for c in action.choices)
            specs.append(f"'{position}:{message}:({choices_str})'")
        else:
            specs.append(f"'{position}:{message}:_mb_course_shortnames'")
    return specs


def _zsh_subcommand_entries(parser: argparse.ArgumentParser) -> list[str]:
    """One RAW 'name:description' zsh entry per direct sub-command this
    parser's own add_subparsers() group defines, in registration order,
    for feeding straight to _describe (array-literal elements -- these
    don't need backslash line-continuation, only _arguments calls do)."""
    entries = []
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for choice_action in action._choices_actions:
                desc = _zsh_escape(choice_action.help or "")
                entries.append(f"'{choice_action.dest}:{desc}'")
    return entries


def _zsh_subparser_choices(parser: argparse.ArgumentParser) -> dict[str, argparse.ArgumentParser]:
    """{name: subparser} for this parser's own direct add_subparsers()
    group, or {} if it has none."""
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            return dict(action.choices)
    return {}


def _zsh_join(specs: list[str], indent: str) -> str:
    """Assembles RAW spec strings (from _zsh_option_specs/state-directive
    literals) into a valid zsh multi-line backslash-continued block: every
    line ends in ` \\` EXCEPT the last, which must not, or zsh treats what
    follows as a syntax error. Returns "" for an empty list -- callers
    must handle that case themselves (an _arguments call always needs AT
    LEAST one spec/state-directive, so an empty result means "don't emit
    a continuation at all here", not "emit an empty one")."""
    if not specs:
        return ""
    lines = [f"{indent}{s} \\" for s in specs[:-1]] + [f"{indent}{specs[-1]}"]
    return "\n".join(lines)


def _zsh_case_block(name: str, sp: argparse.ArgumentParser, depth: int, indent: str) -> str:
    """One RAW '{name}) ... ;;' case body for the zsh completion
    dispatcher, RECURSIVELY handling however many further levels of
    subcommands `sp` itself has -- `indent` is the indentation of the
    "{name})" line itself; each nested level indents 4 spaces further,
    matching this file's existing visual style.

    2026-07-14: this used to be hardcoded for EXACTLY one extra level of
    nesting below the top level (my-bt <cmd> -> <cmd>'s own direct
    sub-commands, e.g. `admin hash-password`) -- fine while every
    top-level command's children were themselves leaves, but broke
    silently the moment `admin gdpr` got its OWN nested sub-commands
    (`bookings`/`accounts`/`erase`, a THIRD level, added the same day):
    `my-bt admin gdpr -h` always listed them correctly (plain argparse
    introspection, unaffected by this bug), but zsh tab-completion after
    `my-bt admin gdpr ` showed nothing -- confirmed by the operator on the real
    VPS. Rewritten to recurse to whatever depth the real argparse tree
    actually has. Depth-suffixed zsh state names (cmd0/args0, cmd1/args1,
    cmd2/args2, ...) mean a nested `_arguments -C` call at any depth can
    never shadow an ancestor level's $state, however deep the tree
    grows next."""
    nested = _zsh_subparser_choices(sp)
    if not nested:
        own_opts = _zsh_option_specs(sp) + _zsh_positional_specs(sp)
        body = (
            f"_arguments -s \\\n{_zsh_join(own_opts, indent + '      ')}"
            if own_opts else "_arguments -s"
        )
        return f"{indent}{name})\n{indent}  {body}\n{indent}  ;;"

    # body_indent: local -a / _arguments -C / case $state in / closing esac.
    # branch_indent (2 deeper): the cmd{depth}) / args{depth}) labels, and
    # each CHILD's own "{name})" label (one recursive level in).
    # deep_indent (2 deeper still): _describe / case $words[1] in / its esac.
    body_indent = indent + "  "
    branch_indent = indent + "    "
    deep_indent = indent + "      "

    entries = "\n".join(f"{body_indent}{e}" for e in _zsh_subcommand_entries(sp))
    dispatch = _zsh_join(
        _zsh_option_specs(sp) + [f"'1: :->cmd{depth}'", f"'*::arg:->args{depth}'"], indent=body_indent
    )
    child_cases = "\n".join(
        _zsh_case_block(cname, csp, depth + 1, branch_indent)
        for cname, csp in nested.items()
    )
    return f"""{indent}{name})
{body_indent}local -a _mb_sub_cmds{depth}
{body_indent}_mb_sub_cmds{depth}=(
{entries}
{body_indent})
{body_indent}_arguments -C \\
{dispatch}
{body_indent}case $state in
{branch_indent}cmd{depth})
{deep_indent}_describe '{name} sub-command' _mb_sub_cmds{depth}
{deep_indent};;
{branch_indent}args{depth})
{deep_indent}case $words[1] in
{child_cases}
{deep_indent}esac
{deep_indent};;
{body_indent}esac
{indent}  ;;"""


def generate_zsh_completion(parser: argparse.ArgumentParser) -> str:
    """Builds a complete, self-contained `#compdef my-bt` zsh completion
    script by walking `parser`'s own argparse tree -- see the module-level
    comment above this function for why this is generated at RPM %build
    time rather than hand-maintained or self-installed at runtime.

    Covers, at every depth this CLI actually has (top-level commands,
    `admin`'s own second-level sub-commands, and each leaf's own flags):
    real command/flag names with their real one-line help text as the
    completion description, so `my-bt <TAB>`, `my-bt admin <TAB>`, and
    `my-bt <command> --<TAB>` all complete correctly -- this falls out of
    plain zsh completion semantics (`_describe`/`_arguments` already
    filter candidates by whatever's typed so far, at whatever depth), no
    extra code needed for "my-bt a<TAB>" -> admin or "my-bt admin
    gi<TAB>" -> git-snapshot to work once the dispatch tree below is
    wired up correctly.

    Positional argument VALUES: `choices=[...]` positionals (e.g.
    `maintenance on|off|status`) get their exact real choices offered
    (see _zsh_positional_specs); every `--course` option AND any free-
    text positional (show's/cancel's `query`) get course-shortname
    completion via the `_mb_course_shortnames` shell function emitted
    below -- a live `grep` of the real settings.toml at completion time,
    not a build-time-frozen list (course shortnames can change without a
    rebuild, so freezing them here would go stale immediately). Anything
    needing REAL DATA beyond that (an actual registration id/date/email)
    would need to shell out to `my-bt` itself per keystroke (the
    argcomplete approach) -- a much bigger dependency/latency trade-off
    than the operator asked for here, so deliberately not attempted.
    """
    top_entries = "\n".join(f"      {e}" for e in _zsh_subcommand_entries(parser))
    top_choices = _zsh_subparser_choices(parser)
    top_dispatch = _zsh_join(
        _zsh_option_specs(parser) + ["'1: :->cmd'", "'*::arg:->args'"], indent="    "
    )

    leaf_cases = [_zsh_case_block(name, sp, depth=0, indent="        ") for name, sp in top_choices.items()]
    leaf_cases_str = "\n".join(leaf_cases)

    return f"""#compdef my-bt
# Auto-generated by scripts/my-bt's own generate_zsh_completion() at RPM
# build time (packaging/my-booking-tool.spec %build) -- DO NOT hand-edit;
# regenerate by rebuilding the package. Installed into
# %{{_datadir}}/zsh/site-functions/_my-bt, already on every zsh's fpath by
# default -- open a new shell (or run `compinit`) to pick it up.

# 2026-07-09, the operator: "as much autocomplete as possible also if it
# recognises a course-name maybe if this is possible?" -- a LIVE parse of
# the real settings.toml at completion time (via $MY_BOOKING_SETTINGS,
# same env var scripts/my-bt's own --settings default already respects),
# not a list frozen into this file at build time: course shortnames can
# be renamed/added in settings.toml without ever rebuilding the package
# (see `my-bt admin rename-course`), so baking them in here would go
# stale the moment that happens. Silently offers nothing (not an error)
# if settings.toml is unreadable or has no courses -- tab completion
# failing quietly is fine, my-bt itself will give a real error at
# runtime if the typed value doesn't actually exist.
_mb_course_shortnames() {{
  local settings=${{MY_BOOKING_SETTINGS:-/etc/my-booking/settings.toml}}
  [[ -r $settings ]] || return 1
  local -a names
  names=(${{(f)"$(grep -oE '^[[:space:]]*shortname[[:space:]]*=[[:space:]]*\\"[^\\"]+\\"' "$settings" 2>/dev/null | sed -E 's/.*\\"([^\\"]+)\\".*/\\1/')"}})
  (( ${{#names}} )) || return 1
  _describe 'course' names
}}

_my_bt() {{
  local -a _mb_top_cmds
  _mb_top_cmds=(
{top_entries}
  )

  _arguments -C \\
{top_dispatch}

  case $state in
    cmd)
      _describe 'my-bt command' _mb_top_cmds
      ;;
    args)
      case $words[1] in
{leaf_cases_str}
      esac
      ;;
  esac
}}

_my_bt "$@"
"""


def build_parser() -> argparse.ArgumentParser:
    p = _HelpfulArgumentParser(prog="my-bt", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--data-dir", default=DEFAULT_DATA_DIR, help=f"default: {DEFAULT_DATA_DIR}")
    p.add_argument("--settings", default=DEFAULT_SETTINGS, help=f"default: {DEFAULT_SETTINGS}")
    # action="version" is argparse's own special-case: it prints and exits
    # immediately, before the "a subcommand is required" check below would
    # otherwise fire -- so `my-bt --version` works with no subcommand,
    # exactly like `my-bt --help` does.
    p.add_argument(
        "--version", action="version",
        version=app_version.version_string(HOME),
        help="show the package version and the git commit it was built from, then exit",
    )
    p.add_argument(
        "-D", "--debug", action="store_true",
        help="verbose tracing + full tracebacks on error, just for this run "
             "(same effect as MY_BOOKING_DEBUG=1, see README.md 'Logs & debugging')",
    )
    p.add_argument(
        "-L", "--log", action="store_true",
        help="also append this run's output to settings.toml's [logging].log_file "
             "(configure that first -- see README.md 'Logs & debugging')",
    )
    # 2026-07-09, the operator: bare `my-bt` (or `my-bt admin` -- any group that
    # needs a further sub-command) printed argparse's default "the
    # following arguments are required: command" error and exited 2 --
    # "as the --help is displayed to me this is not an error, no need to
    # write this". `required=True` (removed here and on admin_sub below)
    # is what made a missing sub-command an *error* in the first place;
    # `_help_parser` records, on each subparsers-owning parser, which
    # parser's help to show if parsing stops there with no leaf `func`
    # set -- see main()'s own check. Nested subparsers copy their own
    # set_defaults() into the shared namespace as parsing descends (see
    # argparse's _SubParsersAction.__call__), so whichever group parser
    # was actually reached is what ends up in `args._help_parser` -- a
    # leaf command's own set_defaults(func=...) simply doesn't touch this
    # key, so it's never overwritten once real work is going to happen.
    p.set_defaults(_help_parser=p)
    sub = p.add_subparsers(dest="command")

    def scope_args(sp):
        g = sp.add_mutually_exclusive_group()
        g.add_argument(
            "--live", dest="scope", action="store_const", const="live",
            help="only live rows (data/registrations.csv or users.csv) -- default is live+archived combined",
        )
        g.add_argument(
            "--archive", "--archived", dest="scope", action="store_const", const="archived",
            help="only archived rows (data/archived/*.csv -- what GDPR erasure moves rows into, "
                 "see `my-bt erase`), as-is, no merge onto any live account (see `my-bt list --all` for that)",
        )
        sp.set_defaults(scope="all")

    def format_arg(sp):
        sp.add_argument(
            "--format", choices=["table", "csv", "json"], default="table",
            help="output format (default: table)",
        )

    def raw_arg(sp, what: str):
        # 2026-07-13, the operator: "--raw or -r always shows the TABLE for users
        # and list etc. and the default command shows it cleant up without
        # technical ids to ideally have a compact readable output ... for
        # my-bt list: can you mimick the view of the web-interface?" --
        # default output is now the same compact, human-readable shape
        # /admin's own web table shows (no registration_id/user_id/
        # party_id/token hashes); -r/--raw brings back every raw CSV
        # column, exactly what this command printed unconditionally before
        # 2026-07-13. Deliberately a SEPARATE axis from -V/--verbose
        # (`status`) -- the operator, same round: "this is better not to overload
        # -V with different meanings" -- -V adds MORE detail on top of a
        # summary, -r/--raw swaps the SHAPE of what's already there.
        sp.add_argument(
            "-r", "--raw", action="store_true",
            help=f"show every raw CSV column (incl. ids/hashes) instead of the default, "
                 f"cleaned-up {what} view",
        )

    sp = _add_subcommand(
        sub, "list",
        "query registrations -- default: today+future, live only "
        "(see --all/--past for more, incl. archived pre-erasure history).",
        "Default output mirrors /admin's clean web view (no ids/hashes) -- "
        "pass -r/--raw for every raw CSV column instead.",
    )
    format_arg(sp)
    raw_arg(sp, "list")
    sp.add_argument(
        "-V", "--verbose", action="store_true",
        help="also show the 'registered' and 'guests' columns -- hidden by default",
    )
    sp.add_argument("--course", help="filter by course shortname")
    sp.add_argument(
        "--status", choices=["confirmed", "waitlisted", "canceled_by_guest", "canceled_by_host"],
        help="filter to one status",
    )
    sp.add_argument("--email", help="filter by (partial, case-insensitive) attendee email")
    sp.add_argument("--user-id", help="filter to one exact user_id")
    sp.add_argument("--year", type=int, help="shorthand for --from YYYY-01-01 --to YYYY-12-31")
    sp.add_argument("--from", dest="from_", help="occurrence_date >= YYYY-MM-DD")
    sp.add_argument("--to", help="occurrence_date <= YYYY-MM-DD")
    date_scope = sp.add_mutually_exclusive_group()
    date_scope.add_argument(
        "--all", action="store_true",
        help="every date, live + archived -- a live user's pre-erasure archived history is merged in "
             "on the fly (nothing is written to disk, see `my-bt admin dearchive` to persist that); "
             "this is also what `my-bt history` used to be for (dropped 2026-07-13, folded in here: "
             "`list --all --email x@y.com` shows an attendee's full combined history)",
    )
    date_scope.add_argument(
        "--past", action="store_true",
        help="same as --all, but occurrence_date strictly before today only",
    )
    sp.set_defaults(func=cmd_list)

    sp = _add_subcommand(
        sub, "users",
        "list attendee accounts (default: live accounts that have actually logged in).",
        "--live: every live account, including ones that have never logged in. --archive: "
        "only archived accounts (see `my-bt erase`). --all: live + archived combined, no "
        "login-date filter (2026-07-14: this used to be the bare default; the bare default "
        "is now the narrower logged-in-live view above, the operator: \"actually no: by default "
        "my-bt users should show --live users that logged in\"). Same -r/--raw and --format "
        "options as `my-bt list`. See also `my-bt users logout` below.",
    )
    users_scope = sp.add_mutually_exclusive_group()
    users_scope.add_argument(
        "--live", dest="scope", action="store_const", const="live",
        help="every live account, including ones that have never logged in (last_login_at blank)",
    )
    users_scope.add_argument(
        "--archive", "--archived", dest="scope", action="store_const", const="archived",
        help="only archived accounts (see `my-bt erase`), as-is",
    )
    users_scope.add_argument(
        "--all", dest="scope", action="store_const", const="all",
        help="live + archived combined, no login-date filter (the pre-2026-07-14 bare default)",
    )
    sp.set_defaults(scope=None)
    format_arg(sp)
    raw_arg(sp, "users")
    sp.add_argument(
        "-V", "--verbose", action="store_true",
        help="show full joined/last_login timestamps (date_HHMM.SS) instead of just YYYY-MM-DD",
    )
    sp.add_argument("--email", help="filter by (partial, case-insensitive) email")
    sp.add_argument(
        "--internal-url", default=DEFAULT_INTERNAL_URL,
        help="base URL of the running app's own loopback listener, queried (clean view only, "
             "not -r/--raw) for the new 'session' column (default: %(default)s, "
             "or $MY_BOOKING_INTERNAL_URL)",
    )
    sp.set_defaults(func=cmd_users)
    users_sub = sp.add_subparsers(dest="users_command")
    lo = _add_subcommand(
        users_sub, "logout",
        "force-log-out an attendee (or --all for everyone) -- same command as `my-bt admin logout`.",
        "2026-07-10, the operator: \"lets add 'logout <EMAIL>' and 'logout --all' as possibilities to "
        "my-bt users\" -- discoverable from here too since you're probably already looking at "
        "`my-bt users`'s new 'session' column when you reach for this, but the actual command "
        "stays `my-bt admin logout` (the operator, on where it should live: \"we have BOTH\") -- this "
        "is the exact same cmd_admin_logout, just reachable from a second spot.",
    )
    lo.add_argument("email_pos", nargs="?", metavar="EMAIL", help="attendee's login email (or use --all below)")
    lo.add_argument("--all", action="store_true", help="log out EVERY active session, guest and admin alike")
    lo.add_argument(
        "--internal-url", default=DEFAULT_INTERNAL_URL,
        help="base URL of the running app's own loopback listener (default: %(default)s, "
             "or $MY_BOOKING_INTERNAL_URL)",
    )
    lo.set_defaults(func=cmd_admin_logout)

    sp = _add_subcommand(
        sub, "show", "show any entity: a registration/booking, a course, a course-occurrence, or a user.",
        "Auto-detects from ONE query -- registration id (short or full), course shortname, "
        "YYYY-MM-DD date, or a name/email substring -- or force a type with --course/--user.",
    )
    format_arg(sp)
    query_group = sp.add_mutually_exclusive_group()
    query_group.add_argument(
        "query", nargs="?",
        help="anything: registration id (short or full, see `my-bt list`'s own 'id' column), "
             "course shortname, YYYY-MM-DD date, or a name/email substring -- auto-detected",
    )
    query_group.add_argument("--course", help="force: show this course (by shortname) directly")
    query_group.add_argument("--user", help="force: search users by this name/email substring directly")
    sp.add_argument("--date", help="paired with --course: show that one course-occurrence directly")
    sp.set_defaults(func=cmd_show, _help_parser=sp)

    sp = _add_subcommand(
        sub, "stats", "counts per course/status.",
        "Quick capacity/attendance overview without listing every individual row.",
    )
    scope_args(sp)
    format_arg(sp)
    sp.add_argument("--year", type=int, help="restrict to one year (occurrence_date starts with this year)")
    sp.set_defaults(func=cmd_stats)

    sp = _add_subcommand(
        sub, "cancel",
        "cancel by registration id (one booking), or by date (+course if ambiguous, every booking "
        "for that occurrence) -- host-initiated, same as the web admin's cancel.",
        "Auto-detects a registration id or date from ONE positional query, same as `my-bt show` -- "
        "or force a type with --id/--date/--course.",
    )
    id_group = sp.add_mutually_exclusive_group(required=True)
    id_group.add_argument(
        "query", nargs="?",
        help="anything: a registration id (short or full, see `my-bt list`'s own 'id' column) or a "
             "YYYY-MM-DD date -- auto-detected, same as `my-bt show`'s own query",
    )
    id_group.add_argument(
        "--id",
        help="force: registration id (short or full, see `my-bt list`'s own 'id' column) of the "
             "one registration to cancel",
    )
    id_group.add_argument(
        "--date", help="force: cancel EVERY live registration for this occurrence (YYYY-MM-DD) -- pair "
                        "with --course if more than one course is ever booked on the same date",
    )
    sp.add_argument("--course", help="course shortname, only used (and only needed if ambiguous) with --date/query")
    sp.add_argument("-m", "--message", help="optional message included in the cancellation emails")
    sp.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    sp.set_defaults(func=cmd_cancel, _help_parser=sp)

    sp = _add_subcommand(
        sub, "status",
        "live server summary: up/running, maintenance mode, logged-in users "
        "(see `my-bt admin health` for the full settings/secrets/systemd/SELinux/nginx report).",
        "Fast and live-only -- queries the running process directly over its "
        "own loopback listener, no deep install diagnostics.",
    )
    sp.add_argument(
        "--internal-url", default=DEFAULT_INTERNAL_URL,
        help="base URL of the running app's own loopback listener, queried for the live "
             "maintenance-mode/logged-in-users summary (default: %(default)s, "
             "or $MY_BOOKING_INTERNAL_URL)",
    )
    sp.set_defaults(func=cmd_status)

    # -- admin: heavier/riskier site-administration actions, grouped under
    # one namespace (2026-07-13, the operator's own restructuring proposal) --
    # rarely-needed-day-to-day commands live here instead of cluttering
    # the top level next to `list`/`status`/`cancel`, which you reach for
    # far more often.
    admin_sp = _add_subcommand(
        sub, "admin", "site-administration commands (setup, secrets, GDPR erasure, ...).",
        "These are the heavier, rarely-needed actions -- day-to-day use is "
        "`list`/`status`/`cancel` at the top level.",
    )
    admin_sp.set_defaults(_help_parser=admin_sp)
    admin_sub = admin_sp.add_subparsers(dest="admin_command")

    sp = _add_subcommand(
        admin_sub, "hash-password", "generate admin_password_hash (prompts, hidden input).",
        "Paste the output into /etc/my-booking/secrets/admin_password_hash.",
    )
    sp.set_defaults(func=cmd_hash_password)

    sp = _add_subcommand(
        admin_sub, "gdpr",
        "GDPR: manual erasure, retention overview, and per-item expiry lists for bookings and accounts.",
        "Bare `admin gdpr` only reports (retention window + counts past due); nothing is "
        "ever purged/erased without an explicit `erase` / `bookings --purge` / `accounts --purge`.",
    )
    sp.set_defaults(func=cmd_admin_gdpr)
    gdpr_sub = sp.add_subparsers(dest="gdpr_command")
    ge = _add_subcommand(
        gdpr_sub, "erase", "manually erase an attendee's data (GDPR Art. 17).",
        "Same effect as an attendee self-erasing via /my, just host-initiated. "
        "2026-07-14: moved here from `admin erase` to sit alongside the rest of GDPR. "
        "2026-07-16: the email can be given as a plain positional argument now too, "
        "not just --email (the operator: \"--email should be optional here simply, "
        "my-bt admin erase operator@example.org should work as well\").",
    )
    ge.add_argument(
        "email_pos", nargs="?", metavar="EMAIL",
        help="the attendee's login email (or use --email below)",
    )
    ge.add_argument("--email", dest="email_flag", help="the attendee's login email (same as the positional EMAIL)")
    ge.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    ge.set_defaults(func=cmd_erase)
    gb = _add_subcommand(
        gdpr_sub, "bookings", "list registrations and the date each would be purged.",
        "Add --purge to actually delete rows past their retention window now -- the same "
        "job the nightly systemd timer runs (systemd/my-booking-retention.timer).",
