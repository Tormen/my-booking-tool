# The running service reads this file ONCE, at startup. After ANY edit
# here, activate it with:
#
#     sudo my-bt admin health     # verify the file parses and is sane
#     sudo systemctl restart my-booking
#
# (`my-bt ...` commands re-read this file on every run, so they show a
# new value immediately -- the live site does not, until that restart.)
#
[site]
timezone    = "Europe/Berlin"
admin_email = "admin@example.org"
base_url    = "https://example.org"
#
# Where the LIVE static site (site/*.html from this repo, copied over by
# hand -- see README.md "Static-site pages") actually lives, so `my-bt
# status` can detect a stale privacy.html (retention numbers out of sync
# with this file) and `my-bt setup -i` can regenerate it directly there.
# Comment out / remove to skip that check entirely.
static_site_dir = "/var/www/example.org"
#
# Optional: whether `my-bt setup -i` derives a no-JavaScript
# index_embedded.html straight from the LIVE index.html above (see
# README.md "Static-site pages") plus this settings.toml, and offers to
# deploy it alongside index.html at static_site_dir. Off by default --
# most deployments don't embed their site via <iframe> elsewhere. Comment
# out / remove (or set to false) to skip this entirely.
index_embedded_enabled = false
#
# Only relevant when index_embedded_enabled = true above. true (default):
# every outbound link on the derived page (Login, course booking links,
# footer legal links) opens in a NEW tab (target="_blank"
# rel="noopener noreferrer") -- the booking flow and /my genuinely need
# JavaScript, which should run in a normal top-level tab, not inside the
# embedding iframe. false: same tab, target="_top" (the same convention
# index.html's own Login link already uses).
index_embedded_new_tab_links = true
#
# Optional: an operator-authored message shown in the same red ATTENTION
# box as any auto-generated [[course.date_override]] line (on index.html,
# index_embedded.html, and each affected course's /book/<shortname> page),
# below any auto-generated line, separated by a horizontal rule when both
# are present (shown alone if there are no upcoming overrides). Understands
# raw HTML formatting tags -- not escaped, same trust boundary as a
# course's description. Empty (default): nothing shown unless there's an
# actual upcoming date override.
# custom_attention_message = "On vacation from 2026-08-01 til 2026-08-15, courses resume afterwards at their usual schedule."
#
# Optional: a directory of custom email templates to use instead of
# this repo's own built-in ones. Every participant-facing email (booking
# confirmed/waitlisted, canceled, reinstated, promoted-from-waitlist,
# account confirm/reset, email-change) reads a matching file HERE first
# if it exists; a missing file
# here (or leaving this unset entirely) falls back to this repo's own
# built-in copy under email_templates/, so you only need to place the
# SPECIFIC template(s) you actually want to customize. Templates use
# {{macro}}/{{variable}} placeholders -- see app/email_templates.py and
# the built-in email_templates/*.txt/.html files for what each one
# supports.
# email_templates_folder = "/opt/my-booking/email_templates"
# Absolute path to the REAL, currently-deployed nginx vhost conf file for
# this site -- wherever nginx actually loads it from on this box, NOT this
# checkout's own site/nginx-locations.conf copy (nginx doesn't care what
# the file is called, so you're free to name the live one anything --
# nginx-locations.conf below is just an example). When set, `my-bt
# status`/`setup` read THIS exact file directly (not `nginx -T`'s merged
# dump -- works even without the nginx binary, and reflects precisely
# what's on disk right now) to confirm every location block this app needs
# is present and there's no leftover REPLACE-ME placeholder, and `setup -i`
# offers a vimdiff against this checkout's site/nginx-locations.conf(.example)
# if the two differ. Unlike static_site_dir above, a problem found here is
# a hard FAILURE, not a warning -- setting this path is you telling us this
# file is real and matters. Comment out / remove to skip this check entirely.
# nginx_conf_path = "/etc/nginx/conf.d/nginx-locations.conf"
# Optional: while `my-bt admin site-maintenance on` is blocking every participant-facing
# page for everyone (see README.md "Maintenance mode" for the exact route
# list), a request whose (nginx-forwarded) client IP matches
# EITHER of these two still gets through as normal -- handy so you can
# still test/use the live booking flow yourself during a maintenance
# window. Both are optional and independent (either alone is enough);
# leave both unset (the default) for no bypass at all. Re-checked fresh on
# every request while maintenance is on, never cached.
# maintenance_bypass_hostname = "your-dynamic-dns-name.example"
# A plain text file whose LAST non-empty line is your current IP, kept
# fresh by infrastructure outside this app (e.g. a script watching your own
# WAN IP) -- useful as a fallback for when DNS hasn't caught up with a
# recent IP change yet.
# maintenance_bypass_ip_log = "/home/you/my-ip.log"

[booking_calendar]
# The READ+WRITE CalDAV calendar this tool's own course events, blocker
# events and sync live in. CalDAV only -- published .ics links are
# one-way, read-only exports; there is no writable-ics standard.
caldav_url    = "https://dav.example.org/"
username      = "calendar@example.org"
password_file = "/etc/my-booking/secrets/caldav_password"
calendar      = "Bookings"
# Calendar-invite reminders (minutes before start). Optional -- omit
# either line to get its default. trainer_reminder_minutes defaults to []
# (no reminder at all) for the operator's own synced calendar event;
# participant_reminder_minutes defaults to [60] (one reminder, 1h before)
# for the .ics attached to a participant's booking-confirmed email.
# Empty list = no VALARMs.
# trainer_reminder_minutes     = []
# participant_reminder_minutes = [60]

# ============================================================================
# [[conflict_calendar]] -- READ-ONLY conflict sources. Any number of blocks;
# each is consulted live for every candidate course date. Every block below is
# written in full teaching form: each knob annotated inline (mandatory /
# optional / default / what it depends on), with the values this template
# ships ACTIVE and the unused options shown commented out right beside them.
# ============================================================================

[[conflict_calendar]]
# WHAT THIS BLOCK DOES: the booking calendar itself, in blocks mode -- how a
# course avoids double-booking against its own synced events, and how a
# "cancel entire session" blocker event hides the canceled date.
# `my-bt admin health` warns if this block is missing.

# (1) IDENTITY + SOURCE -- choose EXACTLY ONE source kind (mandatory: one)
name    = "own-calendar"        # OPTIONAL label (default "conflict-N")
source  = "booking_calendar"    # (a) reuse [booking_calendar]'s connection  <-- USED
#ics_url = "https://.../calendar.ics"                # (b) published ICS link
#caldav_url    = "https://dav.example.org/caldav/"   # (c) own CalDAV, and then
#username      = "cal@example.org"                    #     these THREE become
#password_file = "/etc/my-booking/secrets/other_caldav_password"  # mandatory:
#calendar      = "Work"                              #     username/pw/calendar

# (2) MODE + its window
mode    = "blocks"              # "requires" (default) | "blocks"  <-- USED:
#                               #   blocks   -> event OVERLAPPING window HIDES date
#                               #   requires -> ONE event must SPAN window, else HIDE
#from    = "HH:MM"              # OPTIONAL window start (default: this course's start)
#till    = "HH:MM"              # OPTIONAL window end   (default: this course's end);
#                               #   both work in EITHER mode (overlap/span window)

# (3) FILTERS -- which events COUNT, and which courses (any source, any mode)
#show_as = "any"               # DEFAULT DEPENDS ON MODE: "any" for blocks (this),
#                               #   "oof" for requires. oof|busy|tentative|free|
#                               #   workingelsewhere|any ("ooo" = oof alias)
#title_contains = "text"       # OPTIONAL; event title must contain this (default off)
# Course scope -- at most ONE of the next two (mutually exclusive); omit BOTH
# (the default, as shipped) = this block checks EVERY course against the calendar:
#courses         = ["morning-flow"]   # whitelist: apply ONLY to these
#all_courses_but = ["morning-flow"]   # blacklist: apply to all courses EXCEPT these
#all_day_events_also_count         = true  # default true: all-day events count like
#                               #   timed ones; false -> all-day (birthdays) ignored
#all_day_non_blocking_title_marker = ""    # default "" (off): all-day title contains
#                               #   this -> ignored, e.g. "#free" in "Offsite #free"
#all_day_free_events_do_not_block  = true  # default true: all-day "Free" ignored
#                               #   (many apps default all-day to Free; set "Busy"
#                               #   to count). Applies to ICS sources too.

# (4) ICS-ONLY (ignored for CalDAV / booking_calendar) -- N/A for this source
#cache_minutes = 10            # ICS only, default 10: in-process fetch-cache TTL (min)
#debug         = true          # ICS only, default false: verbose per-fetch log trace

# ----------------------------------------------------------------------------
# OPTIONAL second block (shipped commented out -- uncomment the key lines and
# fill in your own feed to enable). Same full teaching form as block A. Use it
# to ALSO gate courses on ANOTHER calendar, e.g. your employer's published
# Outlook feed: "no matching event = no session". Published ICS links are
# cached under /var/lib/my-booking/conflict_cache/ and reused if the source is
# down (a WARNING then a RESOLVED email to admin_email). Outlook refreshes
# published calendars on ITS own schedule -- the feed can lag by min-to-hours.
#
#[[conflict_calendar]]
#
# (1) IDENTITY + SOURCE -- choose EXACTLY ONE source kind (mandatory: one)
#name    = "work"               # OPTIONAL label (default "conflict-N")
##source  = "booking_calendar"  # (a) reuse [booking_calendar]'s connection
#ics_url = "https://outlook.office365.com/owa/calendar/REPLACE-ME/calendar.ics"  # (b) published ICS link  <-- USED
##caldav_url    = "https://dav.example.org/caldav/"  # (c) own CalDAV, and then
##username      = "cal@example.org"                   #     these THREE become
##password_file = "/etc/my-booking/secrets/other_caldav_password"  # mandatory:
##calendar      = "Work"                             #     username/pw/calendar
#
# (2) MODE + its window
#mode    = "requires"           # "requires" (default, USED here) | "blocks":
#                               #   requires -> ONE event must SPAN window, else HIDE
#                               #   blocks   -> event OVERLAPPING window HIDES date
##from    = "HH:MM"             # OPTIONAL window start (default: this course's start)
##till    = "HH:MM"             # OPTIONAL window end   (default: this course's end);
#                               #   both work in EITHER mode (span/overlap window)
#
# (3) FILTERS -- which events COUNT, and which courses
##show_as = "oof"              # DEFAULT DEPENDS ON MODE: "oof" for requires (this),
#                               #   "any" for blocks. busy|tentative|free|
#                               #   workingelsewhere|any ("ooo" = oof alias)
##title_contains = "text"      # OPTIONAL; event title must contain this (default off)
# Course scope -- at most ONE (mutually exclusive); omit both = every course:
#courses = ["morning-flow"]     # whitelist: apply ONLY to these  <-- USED
##all_courses_but = ["other-course"]  # blacklist form (apply to all EXCEPT these)
##all_day_events_also_count         = true  # default true (see block A for the
##all_day_non_blocking_title_marker = ""    #   full meaning of the 3 all-day knobs;
##all_day_free_events_do_not_block  = true  #   identical here, ICS feeds included)
#
# (4) ICS-ONLY (this IS an ICS source, so these apply)
##cache_minutes = 10           # ICS only, default 10: in-process fetch-cache TTL (min)
##debug   = true               # ICS only, default false: verbose per-fetch log trace
#                               #   at WARNING -- stat+sha256 of .ics/.ics.prev, a
#                               #   /bin/cp -a backup before fetch, bytes+hash, pid.
#                               #   Diagnostic only, noisy; leave off in normal use.

[smtp]
host          = "smtp.example.org"
port          = 465
username      = "calendar@example.org"
password_file = "/etc/my-booking/secrets/smtp_password"
from_address  = "admin@example.org"
# Optional, comma-separated: BCC these addresses on every attendee-facing
# email, e.g. to monitor what participants actually receive. Applied only to
# attendee/participant-facing emails (booking confirmed/waitlisted, promoted,
# canceled, reinstated, account confirm/reset/email-change) -- never to the
# separate admin-facing copy of the same event (that already goes straight
# to admin_email), and never to operator-only mail like the watchdog alert.
# Leave unset (the default) to disable entirely.
# bcc_attendee_emails = "you@example.org"

[admin]
password_hash_file = "/etc/my-booking/secrets/admin_password_hash"

[defaults]
# How many upcoming occurrences to offer on the booking page at once.
show_next_slots  = 4
# ...but never look further ahead than this many days, even if that means
# offering fewer than show_next_slots occurrences. Whichever limit is hit
# first wins (see app/slots.py::build_occurrences).
show_next_days   = 42
# Occurrences stay visible and bookable right up until they start -- this
# no longer hides anything. Instead it gates a LATE booking (made within
# this many hours of start): allowed normally if min_required_participants
# is already met, or if this booking is the one that reaches it; rejected
# with a short explanation only if quorum still wouldn't be met (see
# app/webapp.py::book). Has no effect at all while min_required_participants
# is 1 (the default) -- a single booking always meets that on its own.
min_notice_hours = 2
# Minimum CONFIRMED bookings needed for a course to run -- see
# min_notice_hours above for how the two combine on a LATE booking. Default
# 1 = never blocks anyone. Raise this only if a course genuinely shouldn't
# run below a certain group size.
min_required_participants = 1
# Show "N spot(s) left" / "FULL, join waitlist" on the booking page at all.
show_spots_left = true
# Text on the booking page's submit button for a bookable (not full)
# occurrence -- always "Join waitlist" instead for a full one, regardless
# of this setting, since that label has to stay literally true to what
# submitting the form actually does.
book_button_label = "Book"
# Max number of "+ Add participant" rows the booking form offers (and
# the most extra participants a submitted form's own POST will ever get
# admitted -- see app/webapp.py's _parse_guest_entries).
max_participants = 3
# Displayed-only offset for A/B-testing whether perceived scarcity changes
# booking behaviour. Positive = show fewer spots than really available
# (more urgency), negative = show more, 0 = show the real number. This
# NEVER affects actual capacity/waitlist decisions -- those always use the
# true confirmed count (see app/webapp.py::_spots_left_text and
# app/storage.py::add_registration_checking_capacity). Also never makes an
# occurrence claim "FULL" when it genuinely isn't -- only the number
# shown while there's real room shifts; a truly-full occurrence always
# says so, since that's what "join waitlist" in the email will actually do.
spots_left_offset = 0
# A brand-new email's first booking is held as PENDING (no real capacity,
# no calendar sync) until the participant clicks the confirmation link emailed to
# them and sets a password -- see README's "Account confirmation" section.
# A pending row abandoned longer than this many HOURS is purged by the
# retention job (app/retention.py), independent of retention_months below.
pending_confirmation_hours = 48

[privacy]
# GDPR storage-limitation (Art. 5(1)(e)): how long a registration row is kept
# after its course occurrence date before the retention job purges it.
# 24 months is a reasonable starting point (long enough to resolve disputes /
# show attendance history, short enough to stay defensible as "no longer
# than necessary"). Change freely; there is no legally mandated number --
# but see README.md's disclaimer: you are responsible for confirming
# whatever number you pick is appropriate for your own situation.
retention_months = 24
# Canceled registrations are less useful to keep around; purge them sooner.
canceled_retention_months = 6
# Secret HMAC key used to hash a participant's email address when they exercise
# their right to erasure (Art. 17). Generated once by scripts/install.sh
# (`openssl rand -hex 32`); rotating it means previously-erased emails can no
# longer be recognized as "the same erased person" if they ever come up again.
erasure_pepper_file = "/etc/my-booking/secrets/erasure_pepper"
# Optional: a dormant-account warning (one email, not a series of
# nudges) sent this many days BEFORE an account would reach
# retention_months above of inactivity (latest of last login, account
# creation, or last booking made -- see app/retention.py). 0 (the
# default), a blank string, or leaving this commented out all disable the
# warning entirely -- no automated account deletion happens either way;
# this only controls the WARNING email, see app.retention's own docstring.
# how_many_days_before_account_deletion_send_warning_mail = 30

[logging]
# ON by default: the web service, the retention job, and `my-bt -L`/
# `--log` all append their logs to this one file (size-capped rotation,
# ~2 MB x 4 files), in addition to stdout/journal -- a single place to
# `tail -f`, and REQUIRED by the watchdog's rate-limit-block alerting
# and the CSP-violation checks in `my-bt admin health`/`setup`, which
# read only this file (see README.md "Logs & debugging"). Leaving the
# key commented out uses the default path below; set log_file = "" to
# explicitly disable file logging (stdout/journal only).
# Must be writable by the my-booking user/group -- the default path is
# inside /var/lib/my-booking, which the RPM already creates with the
# right ownership, so no extra setup is needed.
# log_file = "/var/lib/my-booking/my-booking.log"

[watchdog]
# Periodic health check (systemd/my-booking-watchdog.timer, default every
# 15 min) that emails admin_email once per run if anything below crosses
# its threshold in the last window_minutes -- silent otherwise. This is a
# coarse, sitewide heads-up, NOT a replacement for fail2ban or the app's
# own per-key login rate limiting (both already exist -- see README.md
# "Logs & debugging" and "Watchdog"). Set enabled = false to disable
# entirely (the timer still runs but every check becomes a no-op).
enabled = true
window_minutes = 15
# Path to nginx's access log (combined format). Leave commented out (the
# default) to skip the nginx-burst check entirely.
# nginx_access_log = "/var/log/nginx/access.log"
# Alert if one IP makes at least this many requests within the window.
nginx_request_threshold = 200
# Alert if one IP's 4xx/5xx share of its own requests is at least this
# fraction (0.0-1.0), once it's made enough requests to be meaningful.
nginx_error_rate_threshold = 0.5
# Alert if at least this many pending, unconfirmed signups (see
# storage.STATUS_PENDING_CONFIRMATION) were created within the window --
# the shape a capacity-grab attempt would take.
pending_signup_threshold = 10
# Alert if the app's own log shows at least this many rate-limiter
# rejections (any login/reset key combined) within the window.
rate_limit_block_threshold = 5
# Alert if sshd logged at least this many failed-password attempts
# (any source) within the window -- cruder and sitewide compared to
# fail2ban's own per-IP ban threshold; an early heads-up, not a
# substitute for it.
sshd_failure_threshold = 5
# Alert if the app's own log shows at least this many CSP violation
# reports (browser-reported Content-Security-Policy violations -- most
# often a stale script-src hash after an inline <script> edit, see
# site/nginx-locations.conf.example's own CSP comment) within the window,
# across every distinct violation combined. `my-bt health`/`admin setup`
# always surface ANY CSP violation regardless of this threshold -- this
# only gates the watchdog's own emailed alert. Full detail any time:
# `my-bt admin csp-violations`.
csp_violation_threshold = 3

# REPLACE-ME: the [[course]] blocks below are placeholder examples so this
# file parses and `my-bt`/the app run out of the box -- replace shortname/
# title/location/weekday/start_time/duration_minutes/capacity/audience/
# language/description with your own recurring classes. shortname must be
# URL-safe (used directly in /book/<shortname>) and unique across courses.
# audience is "private" or "public" (display-only, no access control
# difference); language is a free-text tag your own templates/copy can key
# off of if you support more than one. description is rendered as RAW HTML
# on the booking page (not escaped) -- rich text (bold/italic/underline,
# links, bullet lists) is fine here, since this is your own text, not
# participant input. subtitle is optional plain text shown under the title on
# the booking page: omit it entirely to auto-show "<Weekday>s <from>h<mm> -
# <till>h<mm> -- <location>" (e.g. "Saturdays 10h45 - 12h45 -- Ayur Yoga
# Center Trier Nord", as below), set it to "" to show no subtitle at all,
# or set it to any other string to override the auto-derived one.
# order_in_all_courses controls this course's position on /courses (sorted
# ascending, lowest first) -- omit it entirely to just keep this file's own
# [[course]] order (every omitted course defaults to 0 and ties are broken
# by file order, so nothing changes unless you actually set
# order_in_all_courses somewhere). Doesn't need to be unique or contiguous
# -- spacing values out (10, 20, 30, ...) leaves room to slot a new course
# in later without renumbering everything else.
# location_url is optional (2026-07-09): a map/directions link for this
# course's `location` -- when set, /my's own "Location" column for this
# course's bookings becomes a clickable link (opens in a new tab) instead
# of plain text. Omit it entirely to keep plain text, exactly as before
# this existed.
# host_calendar_entry_cc_list is optional: a list of email addresses to
# also invite (cc) on this course's own calendar entry. Each address gets
# added as an ATTENDEE (ROLE=OPT-PARTICIPANT, RSVP=FALSE
# -- a courtesy copy, not a scheduling request) on THIS course's own HOST
# calendar event (never the participant's personal .ics). Omit entirely (the
# default) for no ORGANIZER/ATTENDEE properties at all, exactly as before
# this existed. Whether an address actually receives an invite EMAIL (vs.
# just appearing silently as an attendee) depends on your CalDAV server's
# own scheduling/iTIP support -- test with your own server before relying
# on this.
# host_calendar_entry_cc_list = ["someone@example.org"]
[[course]]
shortname   = "example-monday-class"
title       = "Example Class"
location    = "Example Community Center, Room 1"
location_url = "https://maps.example.com/?q=Example+Community+Center"
weekday     = "mon"
start_time  = "18:00"
duration_minutes = 60
capacity    = 12
audience    = "public"
language    = "en"
description = "Example weekly class. Replace this with your own description."
# subtitle  = "Mondays -- Example Community Center"
order_in_all_courses = 10
# [[course.date_override]]: any number of these per course, to
# exceptionally change the time for this course on a specific date (must
# come directly after that course's own fields, before the next
# [[course]] block, same
# TOML nested-array-of-tables rule as everywhere else), each a one-off
# exception to the normal weekly weekday/start_time/duration_minutes
# above, for exactly ONE date. `duration_minutes` is optional -- omit it
# to keep the course's normal duration and only shift the start time.
# `message` is optional free-text shown alongside the changed time
# everywhere it's displayed -- the booking page, index.html (via a small
# JS snippet fetching /schedule-exceptions -- see site/index.html.example),
# and every confirmation/cancellation email for that date -- all as a red
# "ATTENTION" callout. Omit `message` for just the changed time with no
# explanation. No [[course.date_override]] at all (the default) changes
# nothing.
#
# EVERY override needs its own [[course.date_override]] header line.
# Adding a second date by just repeating the keys under the first header
# is invalid TOML ("Cannot overwrite a value") and the service will
# refuse to start:
#
#     [[course.date_override]]
#     date = "2026-08-03"
#     date = "2026-08-29"      <-- WRONG, no second header
#
# [[course.date_override]]
# date = "2026-08-03"
# start_time = "09:00"
# message = "Exceptionally an hour earlier this week only."
#
# [[course.date_override]]
# date = "2026-08-29"
# start_time = "09:00"
# message = "And once more, three weeks later."

[[course]]
shortname  = "example-thursday-class"
title      = "Example Class (Advanced)"
location   = "Example Community Center, Room 2"
weekday    = "thu"
start_time = "19:00"
duration_minutes = 90
capacity   = 10
audience   = "public"
language   = "en"
description = "Second example course, showing a course with different capacity/timing."
order_in_all_courses = 20
