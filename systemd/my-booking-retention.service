[Unit]
Description=my-booking GDPR retention purge (one-shot; triggered by the .timer)

[Service]
Type=oneshot
User=my-booking
Group=my-booking
# 2026-07-14: switched to calling `my-bt admin gdpr` subcommands directly
# -- two ExecStart= lines run in sequence (systemd's own documented
# multi-ExecStart behavior for Type=oneshot), one per `my-bt admin gdpr`
# leaf, rather than the old direct `python3 -m app.retention` (which ran
# both run_purge() and send_account_deletion_warnings() together with no
# way to invoke either on demand -- see `my-bt admin gdpr bookings`/
# `accounts` for that). --purge on each makes both act instead of just
# reporting, same as this timer always did.
ExecStart=/opt/my-booking/bin/my-bt --settings /etc/my-booking/settings.toml --data-dir /var/lib/my-booking admin gdpr bookings --purge
ExecStart=/opt/my-booking/bin/my-bt --settings /etc/my-booking/settings.toml --data-dir /var/lib/my-booking admin gdpr accounts --purge
WorkingDirectory=/opt/my-booking
Environment=PYTHONPATH=/opt/my-booking
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/my-booking
ReadOnlyPaths=/opt/my-booking /etc/my-booking
